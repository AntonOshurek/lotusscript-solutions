import { inject, Injectable } from '@angular/core';

import type { IncidentDecisionKind } from '@entities/governance';

import {
  mapErrorToUiError,
  type UiError,
} from '@shared/error';

import { MtModalService } from '@citi-icg-172888/ng-icgds/modal';

import {
  INCIDENT_CONFIRMATION_MESSAGES,
  INCIDENT_ERROR_MESSAGES,
  INCIDENT_FALLBACK_MESSAGES,
  INCIDENT_INVALID_PAYLOAD_MESSAGE,
  INCIDENT_SUCCESS_MESSAGES,
  type IncidentDecisionMessage,
} from './incident-decision-notifications.model';

@Injectable()
export class IncidentDecisionDialogService {
  private readonly modalService = inject(MtModalService);

  abandonConfirmation(onAccept: () => void): void {
    this.openConfirmation('ABANDON', onAccept);
  }

  retryConfirmation(onAccept: () => void): void {
    this.openConfirmation('RETRY', onAccept);
  }

  invalidFeaturePayload(): void {
    this.openAlert('danger', INCIDENT_INVALID_PAYLOAD_MESSAGE);
  }

  success(decisionKind: IncidentDecisionKind): void {
    this.openAlert(
      'success',
      INCIDENT_SUCCESS_MESSAGES[decisionKind],
    );
  }

  responseError(err: unknown): void {
    const uiError = mapErrorToUiError(err);
    const detail = uiError.backendError?.detail;

    const message =
      typeof detail === 'string'
        ? INCIDENT_ERROR_MESSAGES[detail]
        : undefined;

    this.openAlert(
      'danger',
      message ?? this.getFallbackErrorMessage(uiError.errorCode),
    );
  }

  private openConfirmation(
    decisionKind: IncidentDecisionKind,
    onAccept: () => void,
  ): void {
    const message = INCIDENT_CONFIRMATION_MESSAGES[decisionKind];

    this.modalService.open({
      status: 'warning',
      title: message.title,
      html: message.html,
      type: 'confirm',
      afterUserAction: event => {
        if (event.action === 'accept') {
          onAccept();
        }
      },
    });
  }

  private getFallbackErrorMessage(
    errorCode: UiError['errorCode'],
  ): IncidentDecisionMessage {
    switch (errorCode) {
      case 400:
        return INCIDENT_FALLBACK_MESSAGES.INVALID_REQUEST;

      case 403:
        return INCIDENT_FALLBACK_MESSAGES.FORBIDDEN;

      case 409:
        return INCIDENT_FALLBACK_MESSAGES.CONFLICT;

      default:
        return INCIDENT_FALLBACK_MESSAGES.UNEXPECTED;
    }
  }

  private openAlert(
    status: 'danger' | 'warning' | 'success',
    message: IncidentDecisionMessage,
  ): void {
    this.modalService.open({
      status,
      title: message.title,
      html: message.html,
      type: 'alert',
    });
  }
}




