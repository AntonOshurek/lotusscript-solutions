import {
  IServerSideDatasource,
  IServerSideGetRowsParams,
} from 'ag-grid-enterprise';
import { Observable } from 'rxjs';

import { ApiFetchDataQueryParams } from '@shared/api';
import {
  mapFiltersToServerPagination,
  mapGridPaginationToServerPagination,
  mapSortOptionsToServerPagination,
} from '@shared/ui/ag-grid/ag-grid-request.mapper';

export function createDatabaseSource<
  T,
  TResponse extends {
    data: T[];
    page: {
      totalItems: number;
    };
  },
>(
  fetchData: (
    queryParams: ApiFetchDataQueryParams,
  ) => Observable<TResponse>,
  onError: (error: unknown) => void,
): IServerSideDatasource<T> {
  return {
    getRows(params: IServerSideGetRowsParams<T>): void {
      const { page, size } =
        mapGridPaginationToServerPagination(params);

      const sort =
        mapSortOptionsToServerPagination(params);

      const filter =
        mapFiltersToServerPagination(
          params.request.filterModel,
        );

      fetchData({
        page,
        size,
        sort,
        filter,
      }).subscribe({
        next: (response) => {
          params.success({
            rowData: response.data,
            rowCount: response.page.totalItems,
          });
        },

        error: (error: unknown) => {
          onError(error);
          params.fail();
        },
      });
    },
  };
}
