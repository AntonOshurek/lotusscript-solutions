const RESOURCE_BUSY_RETRY_COUNT = 2;
const RESOURCE_BUSY_RETRY_DELAY_MS = 500;

private retryResourceBusy<T>(): MonoTypeOperatorFunction<T> {
  return retry<T>({
    count: RESOURCE_BUSY_RETRY_COUNT,

    delay: (error: unknown, retryCount: number) => {
      const uiError = mapErrorToUiError(error);

      const isResourceBusy =
        uiError.errorCode === 409 &&
        uiError.backendError?.detail ===
          'GOV_RESOURCE_BUSY';

      if (!isResourceBusy) {
        return throwError(() => error);
      }

      return timer(
        RESOURCE_BUSY_RETRY_DELAY_MS * retryCount,
      );
    },
  });
}








private setAttribute(
  payload: SetAttributePayload,
  parentName: string,
): void {
  this.loaderService.show();

  defer(() =>
    this.attributeCommandsApi.setAttribute(payload),
  )
    .pipe(
      this.retryResourceBusy(),

      finalize(() => {
        this.loaderService.hide();
      }),
    )
    .subscribe({
      next: ({ data }) => {
        this.dialogService.openSuccess('SET', {
          attributeName: payload.attributeName,
          parentName,
          created: data.created,
        });
      },

      error: (error: unknown) => {
        this.dialogService.openResponseError(error);
      },
    });
}

private clearAttribute(
  payload: ClearAttributePayload,
  parentName: string,
): void {
  this.loaderService.show();

  defer(() =>
    this.attributeCommandsApi.clearAttribute(payload),
  )
    .pipe(
      this.retryResourceBusy(),

      finalize(() => {
        this.loaderService.hide();
      }),
    )
    .subscribe({
      next: ({ data }) => {
        this.dialogService.openSuccess('CLEAR', {
          attributeName: payload.attributeName,
          parentName,
          created: data.created,
        });
      },

      error: (error: unknown) => {
        this.dialogService.openResponseError(error);
      },
    });
}










