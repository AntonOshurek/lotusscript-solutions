import { inject, Injectable } from '@angular/core';

// ENTITIES
import type {
  AttributeParentRow,
  AttributeRow,
} from '@entities/attribute';

// ICG
import { MtModalService } from '@citi-icg-172888/ng-icgds/modal';

interface AttributeDialogParams {
  attributeParent: AttributeParentRow;
  attribute: AttributeRow;
}

interface SetAttributeConfirmationParams extends AttributeDialogParams {
  newValue: string;
  onAccept: () => void;
}

interface ClearAttributeConfirmationParams extends AttributeDialogParams {
  onAccept: () => void;
}

@Injectable({
  providedIn: 'root',
})
export class AttributeChangeDialogService {
  private readonly modalService = inject(MtModalService);

  openInvalidContext(): void {
    this.modalService.open({
      status: 'danger',
      title: 'Nie można wykonać operacji',
      html:
        '<p>Nie udało się zidentyfikować danych edytowanego atrybutu.</p>' +
        '<p>Upewnij się, że edytujesz wartość w kolumnie <b>Wartość atrybutu</b>.</p>' +
        '<p>Odśwież stronę i spróbuj ponownie. Jeśli problem będzie się powtarzał, skontaktuj się z administratorem systemu.</p>',
      type: 'alert',
    });
  }

  openClearConfirmation({
    attributeParent,
    attribute,
    onAccept,
  }: ClearAttributeConfirmationParams): void {
    this.modalService.open({
      status: 'warning',
      title: 'Potwierdź usunięcie wartości atrybutu',
      html:
        `Czy na pewno chcesz usunąć wartość atrybutu ` +
        `<b>${attribute.attributeName}</b>?<br/><br/>` +
        `Element: <b>${attributeParent.parentName}</b><br/>` +
        `Obecna wartość: <b>${attribute.value}</b>`,
      type: 'confirm',
      afterUserAction: (event) => {
        if (event.action === 'accept') {
          onAccept();
        }
      },
    });
  }

  openSetConfirmation({
    attributeParent,
    attribute,
    newValue,
    onAccept,
  }: SetAttributeConfirmationParams): void {
    this.modalService.open({
      status: 'warning',
      title: 'Potwierdź zmianę wartości atrybutu',
      html:
        `Czy na pewno chcesz zmienić wartość atrybutu ` +
        `<b>${attribute.attributeName}</b>?<br/><br/>` +
        `Element: <b>${attributeParent.parentName}</b><br/>` +
        `Obecna wartość: <b>${attribute.value}</b><br/>` +
        `Nowa wartość: <b>${newValue}</b>`,
      type: 'confirm',
      afterUserAction: (event) => {
        if (event.action === 'accept') {
          onAccept();
        }
      },
    });
  }

  openSetSuccess(
    attributeName: string,
    parentName: string,
  ): void {
    this.modalService.open({
      status: 'success',
      title: 'Wysłano zmianę',
      html:
        `Wartość atrybutu <b>${attributeName}</b> ` +
        `dla <b>${parentName}</b> została pomyślnie wysłana do akceptacji.`,
      type: 'alert',
    });
  }

  openClearSuccess(
    attributeName: string,
    parentName: string,
  ): void {
    this.modalService.open({
      status: 'success',
      title: 'Usunięto wartość',
      html:
        `Wartość atrybutu <b>${attributeName}</b> ` +
        `dla <b>${parentName}</b> została pomyślnie usunięta.`,
      type: 'alert',
    });
  }

  openSetError(
    attributeName: string,
    parentName: string,
  ): void {
    this.modalService.open({
      status: 'danger',
      title: 'Błąd wysyłki zmiany do akceptacji',
      html:
        `Wartość atrybutu <b>${attributeName}</b> ` +
        `dla <b>${parentName}</b> nie została wysłana do aktualizacji.`,
      type: 'alert',
    });
  }

  openClearError(
    attributeName: string,
    parentName: string,
  ): void {
    this.modalService.open({
      status: 'danger',
      title: 'Błąd usuwania wartości atrybutu',
      html:
        `Nie udało się usunąć wartości atrybutu <b>${attributeName}</b> ` +
        `dla <b>${parentName}</b>.`,
      type: 'alert',
    });
  }
}






import { inject, Injectable } from '@angular/core';

// ENTITIES
import {
  AttributeCommandsApi,
} from '@entities/attribute';

import type {
  AttributeCellChangeEvent,
  ClearAttributePayload,
  SetAttributePayload,
} from '@entities/attribute';

// MODEL
import { getAttributeChangeContext } from './model/attribute-change-context';
import { AttributeChangeDialogService } from './model/attribute-change-dialog.service';

@Injectable()
export class ChangeAttributeFeature {
  private readonly attributeCommandsApi = inject(AttributeCommandsApi);

  private readonly attributeChangeDialogService =
    inject(AttributeChangeDialogService);

  change(event: AttributeCellChangeEvent): void {
    const context = getAttributeChangeContext(event);

    if (!context) {
      this.attributeChangeDialogService.openInvalidContext();
      return;
    }

    const {
      attributeParent,
      attribute,
      type,
      newValue,
    } = context;

    if (type === 'clear') {
      const payload: ClearAttributePayload = {
        entityId: attributeParent.id,
        attributeName: attribute.attributeName,
        clientKey: crypto.randomUUID(),
      };

      this.attributeChangeDialogService.openClearConfirmation({
        attributeParent,
        attribute,
        onAccept: () =>
          this.clearAttribute(
            payload,
            attributeParent.parentName,
          ),
      });

      return;
    }

    const payload: SetAttributePayload = {
      entityId: attributeParent.id,
      attributeName: attribute.attributeName,
      value: newValue,
      clientKey: crypto.randomUUID(),
    };

    this.attributeChangeDialogService.openSetConfirmation({
      attributeParent,
      attribute,
      newValue,
      onAccept: () =>
        this.setAttribute(
          payload,
          attributeParent.parentName,
        ),
    });
  }

  private setAttribute(
    payload: SetAttributePayload,
    parentName: string,
  ): void {
    this.attributeCommandsApi
      .setAttribute(payload)
      .subscribe({
        next: () => {
          this.attributeChangeDialogService.openSetSuccess(
            payload.attributeName,
            parentName,
          );
        },
        error: () => {
          this.attributeChangeDialogService.openSetError(
            payload.attributeName,
            parentName,
          );
        },
      });
  }

  private clearAttribute(
    payload: ClearAttributePayload,
    parentName: string,
  ): void {
    this.attributeCommandsApi
      .clearAttribute(payload)
      .subscribe({
        next: () => {
          this.attributeChangeDialogService.openClearSuccess(
            payload.attributeName,
            parentName,
          );
        },
        error: () => {
          this.attributeChangeDialogService.openClearError(
            payload.attributeName,
            parentName,
          );
        },
      });
  }
}
