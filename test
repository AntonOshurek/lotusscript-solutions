openInvalidPayload(reason?: string): void {
  const message = this.config.invalidPayload;
  const description = reason?.trim();

  this.openAlert('danger', {
    ...message,
    html: description
      ? `<p>${escapeHtml(description)}</p>${message.html}`
      : message.html,
  });
}




const UPDATE_ROW_INVALID_PAYLOAD_REASONS = {
  EMPTY_PAYLOAD:
    'Brakuje danych potrzebnych do przygotowania żądania.',

  MISSING_TARGET:
    'W metadanych brakuje kodu tabeli.',

  UNSUPPORTED_KEY:
    'Edycja wymaga dokładnie jednej kolumny klucza rekordu.',

  MISSING_KEY_COLUMN:
    'W metadanych nie określono kolumny identyfikatora rekordu.',

  MISSING_VERSION_COLUMN:
    'W metadanych nie określono kolumny wersji rekordu.',

  MISSING_ID:
    'W danych rekordu brakuje pola identyfikatora.',

  MISSING_VERSION:
    'W danych rekordu brakuje pola wersji.',

  EMPTY_ID:
    'Identyfikator rekordu jest pusty.',

  EMPTY_VERSION:
    'Wersja rekordu jest pusta.',

  INVALID_ID:
    'Identyfikator rekordu ma nieprawidłowy format liczbowy.',

  INVALID_VERSION:
    'Wersja rekordu ma nieprawidłowy format liczbowy.',
} as const;









private abortByValidation(
  onError: () => void,
  reason: string,
): void {
  this.dialogService.openInvalidPayload(reason);
  onError();
}












const { targetCode, keyColumns } = payload.targetMetadata;

if (!targetCode?.trim()) {
  this.abortByValidation(
    payload.onError,
    UPDATE_ROW_INVALID_PAYLOAD_REASONS.MISSING_TARGET,
  );
  return;
}

if (keyColumns.length !== 1) {
  this.abortByValidation(
    payload.onError,
    UPDATE_ROW_INVALID_PAYLOAD_REASONS.UNSUPPORTED_KEY,
  );
  return;
}

const keyColumnName = keyColumns[0];

if (!keyColumnName?.trim()) {
  this.abortByValidation(
    payload.onError,
    UPDATE_ROW_INVALID_PAYLOAD_REASONS.MISSING_KEY_COLUMN,
  );
  return;
}

const keyColumn = keyColumnName.toLowerCase();
