private sendUpdate<T extends string = string>(
  payload: RowEditRequestPayload<T>,
  rowEditTarget: RowEditTarget,
) {
  const request: RowEditRequest = {
    targetCode: rowEditTarget,
    clientKey: crypto.randomUUID(),
    keepOther: true,
    rows: [
      {
        pkValue: String(payload.pkValue),
        expectedVersion: payload.expectedVersion,
        newValues: payload.newValues,
      },
    ],
  };

  return defer(() =>
    this.rowEditApiService.submitChanges(request),
  ).pipe(
    retry({
      count: 2,

      delay: (error: unknown, retryCount: number) => {
        const uiError = mapErrorToUiError(error);

        const isResourceBusy =
          uiError.errorCode === 409 &&
          uiError.backendError?.detail ===
            'GOV_RESOURCE_BUSY';

        if (!isResourceBusy) {
          return throwError(() => error);
        }

        return timer(500 * retryCount);
      },
    }),
  );
}







