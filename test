// attribute-change-context.ts

import type {
  AttributeCellChangeEvent,
  AttributeParentRow,
  AttributeRow,
} from '@entities/attribute';

type AttributeChangeType = 'set' | 'clear';

interface AttributeChangeContext {
  parent: AttributeParentRow;
  attribute: AttributeRow;
  type: AttributeChangeType;
  newValue: string;
}

const getAttributeParent = (
  event: AttributeCellChangeEvent,
): AttributeParentRow | null => {
  const parent = event.node.parent?.data;

  return parent?.type === 'AttributeParent'
    ? parent
    : null;
};

const getAttribute = (
  event: AttributeCellChangeEvent,
): AttributeRow | null => {
  const attribute = event.node.data;

  return attribute?.type === 'Atrybut'
    ? attribute
    : null;
};

const getAttributeChangeType = (
  newValue: unknown,
): AttributeChangeType =>
  String(newValue ?? '').length === 0
    ? 'clear'
    : 'set';

const getAttributeChangeContext = (
  event: AttributeCellChangeEvent,
): AttributeChangeContext | null => {
  const parent = getAttributeParent(event);
  const attribute = getAttribute(event);

  if (!parent || !attribute) {
    return null;
  }

  const newValue = String(event.newValue ?? '');

  return {
    parent,
    attribute,
    type: getAttributeChangeType(newValue),
    newValue,
  };
};

export {
  getAttributeChangeContext,
};

export type {
  AttributeChangeContext,
  AttributeChangeType,
};







// attribute-change-dialog.service.ts

import { inject, Injectable } from '@angular/core';

// ENTITIES
import type {
  AttributeParentRow,
  AttributeRow,
} from '@entities/attribute';

// ICG
import { MtModalService } from '@citi-icg-172888/ng-icgds/modal';

interface AttributeChangeConfirmationParams {
  parent: AttributeParentRow;
  attribute: AttributeRow;
  newValue: string;
  onAccept: () => void;
}

@Injectable()
export class AttributeChangeDialogService {
  private readonly modalService = inject(MtModalService);

  openInvalidContext(): void {
    this.modalService.open({
      status: 'danger',
      title: 'Nie można wykonać operacji',
      html:
        '<p>Nie udało się zidentyfikować danych edytowanego atrybutu.<br/>' +
        'Upewnij się, że edytujesz wartość atrybutu w prawidłowym wierszu.</p>' +
        '<p>Odśwież stronę i spróbuj ponownie. Jeśli problem będzie się powtarzał, skontaktuj się z administratorem systemu.</p>',
      type: 'alert',
    });
  }

  openClearConfirmation({
    parent,
    attribute,
    onAccept,
  }: Omit<AttributeChangeConfirmationParams, 'newValue'>): void {
    this.modalService.open({
      status: 'warning',
      title: 'Potwierdź usunięcie wartości atrybutu',
      html:
        `Czy na pewno chcesz usunąć wartość atrybutu ` +
        `<b>${attribute.attributeName}</b>?<br/><br/>` +
        `Element: <b>${parent.parentName}</b><br/>` +
        `Obecna wartość: <b>${attribute.value}</b>`,
      type: 'confirm',

      afterUserAction: (event) => {
        if (event.action === 'accept') {
          onAccept();
        }
      },
    });
  }

  openSetConfirmation({
    parent,
    attribute,
    newValue,
    onAccept,
  }: AttributeChangeConfirmationParams): void {
    this.modalService.open({
      status: 'warning',
      title: 'Potwierdź zmianę wartości atrybutu',
      html:
        `Czy na pewno chcesz zmienić wartość atrybutu ` +
        `<b>${attribute.attributeName}</b>?<br/><br/>` +
        `Element: <b>${parent.parentName}</b><br/>` +
        `Obecna wartość: <b>${attribute.value}</b><br/>` +
        `Nowa wartość: <b>${newValue}</b>`,
      type: 'confirm',

      afterUserAction: (event) => {
        if (event.action === 'accept') {
          onAccept();
        }
      },
    });
  }

  openSetSuccess(
    attributeName: string,
    parentName: string,
  ): void {
    this.modalService.open({
      status: 'success',
      title: 'Wysłano zmianę',
      html:
        `Wartość atrybutu <b>${attributeName}</b> ` +
        `dla <b>${parentName}</b> została pomyślnie wysłana do akceptacji.`,
      type: 'alert',
    });
  }

  openClearSuccess(
    attributeName: string,
    parentName: string,
  ): void {
    this.modalService.open({
      status: 'success',
      title: 'Usunięto wartość',
      html:
        `Wartość atrybutu <b>${attributeName}</b> ` +
        `dla <b>${parentName}</b> została pomyślnie usunięta.`,
      type: 'alert',
    });
  }

  openChangeError(
    attributeName: string,
    parentName: string,
  ): void {
    this.modalService.open({
      status: 'danger',
      title: 'Błąd wysyłki zmiany do akceptacji',
      html:
        `Nie udało się zmodyfikować atrybutu ` +
        `<b>${attributeName}</b> dla <b>${parentName}</b>.`,
      type: 'alert',
    });
  }
}



change(event: AttributeCellChangeEvent): void {
  const context = getAttributeChangeContext(event);

  if (!context) {
    this.attributeChangeDialogService.openInvalidContext();
    return;
  }

  const {
    parent,
    attribute,
    type,
    newValue,
  } = context;

  const payload = {
    entityId: parent.id,
    attributeName: attribute.attributeName,
    value: newValue,
    clientKey: crypto.randomUUID(),
  };

  if (type === 'clear') {
    this.attributeChangeDialogService.openClearConfirmation({
      parent,
      attribute,
      onAccept: () => {
        this.runClearAttribute(payload, parent.parentName);
      },
    });

    return;
  }

  this.attributeChangeDialogService.openSetConfirmation({
    parent,
    attribute,
    newValue,
    onAccept: () => {
      this.runSetAttribute(payload, parent.parentName);
    },
  });
}
