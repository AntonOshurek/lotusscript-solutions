import { Injectable } from '@angular/core';

import type {
  AttributeParentRow,
  AttributeRow,
} from '@entities/attribute';

import type { UiError } from '@shared/error';

import {
  NotificationDialogBase,
  type NotificationMessage,
} from '@shared/notifications';

import {
  ATTRIBUTE_CHANGE_DIALOG_CONFIG,
  ATTRIBUTE_HTTP_ERROR_MESSAGES,
  createSetAttributeConfirmation,
  createClearAttributeConfirmation,
  createAttributeSuccessMessage,
  type AttributeChangeAction,
  type AttributeSuccessData,
} from './attribute-change-notifications.model';

type AttributeConfirmationParams = {
  readonly parent: AttributeParentRow;
  readonly attribute: AttributeRow;
  readonly onAccept: () => void;
};

type SetAttributeConfirmationParams = AttributeConfirmationParams & {
  readonly newValue: string;
};

@Injectable({ providedIn: 'root' })
export class AttributeChangeDialogService
  extends NotificationDialogBase<AttributeChangeAction> {

  constructor() {
    super(ATTRIBUTE_CHANGE_DIALOG_CONFIG);
  }

  openSetConfirmation({
    parent,
    attribute,
    newValue,
    onAccept,
  }: SetAttributeConfirmationParams): void {
    this.openConfirmationMessage(
      createSetAttributeConfirmation({
        attributeName: attribute.attributeName,
        parentName: parent.parentName,
        currentValue: attribute.value,
        newValue,
      }),
      onAccept,
    );
  }

  openClearConfirmation({
    parent,
    attribute,
    onAccept,
  }: AttributeConfirmationParams): void {
    this.openConfirmationMessage(
      createClearAttributeConfirmation({
        attributeName: attribute.attributeName,
        parentName: parent.parentName,
        currentValue: attribute.value,
      }),
      onAccept,
    );
  }

  openSuccess(
    action: AttributeChangeAction,
    data: AttributeSuccessData,
  ): void {
    this.openAlert(
      'success',
      createAttributeSuccessMessage(action, data),
    );
  }

  protected override getFallbackErrorMessage(
    errorCode: UiError['errorCode'],
  ): NotificationMessage {
    return (
      ATTRIBUTE_HTTP_ERROR_MESSAGES[errorCode]
      ?? super.getFallbackErrorMessage(errorCode)
    );
  }
}










import { inject, Injectable } from '@angular/core';
import { finalize } from 'rxjs';

import type {
  AttributeCellChangeEvent,
} from '@entities/attribute';

import {
  AbacAdminCommandsApi,
  type ClearAttributePayload,
  type SetAttributePayload,
} from '@entities/abac-admin';

import { MtLoaderService } from '@citi-icg-172888/ng-icgds';

import {
  AttributeChangeDialogService,
} from './model/attribute-change-dialog.service';

import {
  getAttributeChangeContext,
} from './model/attribute-change-context';

@Injectable()
export class ChangeAttributeFeature {
  private readonly loaderService = inject(MtLoaderService);

  private readonly attributeCommandsApi = inject(
    AbacAdminCommandsApi,
  );

  private readonly dialogService = inject(
    AttributeChangeDialogService,
  );

  change(event: AttributeCellChangeEvent): void {
    const context = getAttributeChangeContext(event);

    if (!context) {
      this.dialogService.openInvalidPayload();
      return;
    }

    const { parent, attribute, type, newValue } = context;

    if (type === 'clear') {
      const payload: ClearAttributePayload = {
        entityId: parent.id,
        attributeName: attribute.attributeName,
        clientKey: crypto.randomUUID(),
      };

      this.dialogService.openClearConfirmation({
        parent,
        attribute,
        onAccept: () => {
          this.clearAttribute(payload, parent.parentName);
        },
      });

      return;
    }

    const payload: SetAttributePayload = {
      entityId: parent.id,
      attributeName: attribute.attributeName,
      value: newValue,
      clientKey: crypto.randomUUID(),
    };

    this.dialogService.openSetConfirmation({
      parent,
      attribute,
      newValue,
      onAccept: () => {
        this.setAttribute(payload, parent.parentName);
      },
    });
  }

  private setAttribute(
    payload: SetAttributePayload,
    parentName: string,
  ): void {
    this.loaderService.show();

    this.attributeCommandsApi
      .setAttribute(payload)
      .pipe(
        finalize(() => this.loaderService.hide()),
      )
      .subscribe({
        next: ({ data }) => {
          this.dialogService.openSuccess('SET', {
            attributeName: payload.attributeName,
            parentName,
            created: data.created,
          });
        },

        error: (error: unknown) => {
          this.dialogService.openResponseError(error);
        },
      });
  }

  private clearAttribute(
    payload: ClearAttributePayload,
    parentName: string,
  ): void {
    this.loaderService.show();

    this.attributeCommandsApi
      .clearAttribute(payload)
      .pipe(
        finalize(() => this.loaderService.hide()),
      )
      .subscribe({
        next: ({ data }) => {
          this.dialogService.openSuccess('CLEAR', {
            attributeName: payload.attributeName,
            parentName,
            created: data.created,
          });
        },

        error: (error: unknown) => {
          this.dialogService.openResponseError(error);
        },
      });
  }
}










