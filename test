  [pagination]="agGridConfig.pagination"
  [paginationPageSize]="agGridConfig.paginationPageSize"
  [cacheBlockSize]="agGridConfig.cacheBlockSize"
  [paginationPageSizeSelector]="agGridConfig.paginationPageSizeSelector"
  [toolbar]="agGridConfig.toolbar"
  [sideBar]="agGridConfig.sideBar"
  (gridReady)="onGridReady($event)"
  style="width: 100%; height: 100%"
/>

<ng-template #toastTmpl let-toasts="toasts">
  <div class="lm-text-color-2">
    <div class="lm-mb-4px"></div>
    <br />
    <div class="lm-mt-4px">
      Spróbuj ponownie lub skontaktuj się z administratorem systemu
    </div>
  </div>
</ng-template>








export { GrantsOverviewWidget } from './grants-overview.widget';
