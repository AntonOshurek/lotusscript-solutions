.data-date-highlight {
  border-radius: 8px;
  animation: highlight-data-date 3s ease-in-out;
}

@keyframes highlight-data-date {
  0%,
  100% {
    box-shadow: 0 0 0 3px transparent;
    background-color: transparent;
  }

  20%,
  65% {
    box-shadow: 0 0 0 3px #b36b00;
    background-color: #fff4df;
  }
}

@media (prefers-reduced-motion: reduce) {
  .data-date-highlight {
    animation: highlight-data-date-static 3s step-end;
  }

  @keyframes highlight-data-date-static {
    from {
      outline: 2px solid #b36b00;
      outline-offset: 3px;
    }

    to {
      outline: none;
    }
  }
}
