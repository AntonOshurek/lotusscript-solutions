import { Injectable } from '@angular/core';

import {
  NotificationDialogBase,
  type NotificationMessage,
} from '@shared/notifications';

import {
  mapErrorToUiError,
  type UiError,
} from '@shared/error';

import {
  UPDATE_ROW_DIALOG_CONFIG,
  UPDATE_ROW_HTTP_ERROR_MESSAGES,
  UPDATE_ROW_SUCCESS_MESSAGES,
  UPDATE_ROW_VALIDATION_MESSAGES,
  createUpdateRowConfirmation,
  type UpdateRowConfirmationData,
} from './update-row.notifications';

@Injectable({
  providedIn: 'root',
})
export class UpdateRowDialogService
  extends NotificationDialogBase<'UPDATE'> {
  constructor() {
    super(UPDATE_ROW_DIALOG_CONFIG);
  }

  openUpdateConfirmation(
    data: UpdateRowConfirmationData,
    onAccept: () => void,
    onReject: () => void,
  ): void {
    this.openConfirmationMessage(
      createUpdateRowConfirmation(data),
      onAccept,
      onReject,
    );
  }

  openSuccess(created: boolean): void {
    this.openAlert(
      'success',
      created
        ? UPDATE_ROW_SUCCESS_MESSAGES.CREATED
        : UPDATE_ROW_SUCCESS_MESSAGES.ALREADY_CREATED,
    );
  }

  override openResponseError(error: unknown): void {
    const uiError = mapErrorToUiError(error);

    if (
      uiError.errorCode !== 400 ||
      uiError.backendError?.detail !== 'GOV_INTENT_INVALID'
    ) {
      super.openResponseError(error);
      return;
    }

    const items = this.getValidationItems(
      uiError.backendError,
    );

    if (items.length === 0) {
      super.openResponseError(error);
      return;
    }

    this.openAlert('danger', {
      title: 'Dane wymagają poprawy',
      html: `
        <p>Wniosek nie został utworzony.
          Popraw dane edytowanego rekordu.</p>
        <ul>${items.join('')}</ul>
        <p>Jeśli komunikat nie wskazuje kolumny,
          sprawdź wprowadzone wartości w edytowanym rekordzie.</p>
      `,
    });
  }

  protected override getFallbackErrorMessage(
    errorCode: UiError['errorCode'],
  ): NotificationMessage {
    switch (errorCode) {
      case 401:
        return UPDATE_ROW_HTTP_ERROR_MESSAGES
          .AUTHENTICATION_REQUIRED;

      case 429:
        return UPDATE_ROW_HTTP_ERROR_MESSAGES.RATE_LIMITED;

      case 500:
        return UPDATE_ROW_HTTP_ERROR_MESSAGES.SERVER_ERROR;

      case 503:
        return UPDATE_ROW_HTTP_ERROR_MESSAGES
          .SERVICE_UNAVAILABLE;

      default:
        return super.getFallbackErrorMessage(errorCode);
    }
  }

  private getValidationItems(problem: unknown): string[] {
    if (
      typeof problem !== 'object' ||
      problem === null ||
      !('violations' in problem) ||
      !Array.isArray(problem.violations)
    ) {
      return [];
    }

    const items = new Set<string>();

    for (const violation of problem.violations) {
      if (
        typeof violation !== 'object' ||
        violation === null ||
        !('message' in violation) ||
        typeof violation.message !== 'string'
      ) {
        continue;
      }

      const code = violation.message;

      const message =
        Object.prototype.hasOwnProperty.call(
          UPDATE_ROW_VALIDATION_MESSAGES,
          code,
        )
          ? UPDATE_ROW_VALIDATION_MESSAGES[code] ??
            'Wartość nie spełnia wymagań walidacji.'
          : 'Wartość nie spełnia wymagań walidacji.';

      const field =
        'field' in violation &&
        typeof violation.field === 'string'
          ? violation.field
          : '';

      // Obsługuje ścieżkę całego rekordu
      // oraz opcjonalną nazwę kolumny.
      const columnMatch =
        /^(?:rows\[\d+\]\.)?newValues\.(.+)$/.exec(field);

      const column = columnMatch?.[1];

      const location = column
        ? `Kolumna ${this.escapeValidationHtml(column)}: `
        : '';

      items.add(
        `<li>${location}${this.escapeValidationHtml(message)}</li>`,
      );
    }

    return [...items];
  }

  private escapeValidationHtml(value: string): string {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }
}







