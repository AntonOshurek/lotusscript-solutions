import { escapeHtml } from '@shared/lib';

import { DEFAULT_VIOLATION_MESSAGE } from '../model/error-messages.model';
import type { ViolationsBackendError } from '../model/ui-error.model';

const generateViolationHtml = (
  violations: readonly ViolationsBackendError[],
  messages: Readonly<Partial<Record<string, string>>>,
): string => {
  const items = violations.map(({ message: code }) => {
    const message = Object.prototype.hasOwnProperty.call(messages, code)
      ? messages[code] ?? DEFAULT_VIOLATION_MESSAGE
      : DEFAULT_VIOLATION_MESSAGE;

    return `<li>${escapeHtml(message)}</li>`;
  });

  if (items.length === 0) {
    return '';
  }

  return `<ul>${[...new Set(items)].join('')}</ul>`;
};

export { generateViolationHtml };






openResponseError(error: unknown): void {
  this.openUiError(mapErrorToUiError(error));
}

protected openUiError(uiError: UiError): void {
  const detail = uiError.backendError?.detail;

  const message =
    typeof detail === 'string' &&
    Object.prototype.hasOwnProperty.call(this.config.errors, detail)
      ? this.config.errors[detail]
      : undefined;

  this.openErrorAlert(
    uiError,
    message ?? this.getFallbackErrorMessage(uiError.errorCode),
  );
}

protected openErrorAlert(
  uiError: UiError,
  message: NotificationMessage,
): void {
  this.openAlert('danger', {
    ...message,
    html: `${message.html}${generateRequestIdHtml(uiError.requestId)}`,
  });
}









protected override openUiError(uiError: UiError): void {
  const backendError = uiError.backendError;

  if (
    uiError.errorCode !== 400 ||
    backendError?.detail !== 'GOV_INTENT_INVALID'
  ) {
    super.openUiError(uiError);
    return;
  }

  const violationHtml = generateViolationHtml(
    backendError.violations,
    UPDATE_ROW_VALIDATION_MESSAGES,
  );

  if (!violationHtml) {
    super.openUiError(uiError);
    return;
  }

  this.openErrorAlert(uiError, {
    title: 'Dane wymagają poprawy',
    html: `
      <p>
        Wniosek nie został utworzony.
        Popraw dane edytowanego rekordu.
      </p>
      ${violationHtml}
    `,
  });
}
