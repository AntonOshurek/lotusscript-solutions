function escapeHtml(value: string): string {
  return value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function formatValue(value: unknown): string {
  return value === null || value === undefined || value === ''
    ? 'Brak wartości'
    : String(value);
}

function createAttributeDetails(
  data: AttributeNotificationData,
): string {
  return `
    <p>
      Atrybut: <b>${escapeHtml(data.attributeName)}</b><br>
      Element: <b>${escapeHtml(data.parentName)}</b>
    </p>
  `;
}

function createSetAttributeConfirmation(
  data: SetAttributeConfirmationData,
): NotificationMessage {
  return {
    title: ATTRIBUTE_CONFIRMATION_MESSAGES.SET.title,
    html: `
      ${ATTRIBUTE_CONFIRMATION_MESSAGES.SET.html}
      ${createAttributeDetails(data)}
      <p>
        Obecna wartość:
        <b>${escapeHtml(formatValue(data.currentValue))}</b><br>
        Proponowana wartość:
        <b>${escapeHtml(formatValue(data.newValue))}</b>
      </p>
    `,
  };
}

function createClearAttributeConfirmation(
  data: AttributeConfirmationData,
): NotificationMessage {
  return {
    title: ATTRIBUTE_CONFIRMATION_MESSAGES.CLEAR.title,
    html: `
      ${ATTRIBUTE_CONFIRMATION_MESSAGES.CLEAR.html}
      ${createAttributeDetails(data)}
      <p>
        Obecna wartość:
        <b>${escapeHtml(formatValue(data.currentValue))}</b>
      </p>
    `,
  };
}

function createAttributeSuccessMessage(
  action: AttributeChangeAction,
  data: AttributeSuccessData,
): NotificationMessage {
  if (!data.created) {
    return {
      title: 'Wniosek już istnieje',
      html: `
        <p>Ta czynność została już wcześniej zgłoszona.
        Nie utworzono kolejnego wniosku.</p>
        ${createAttributeDetails(data)}
        <p>Sprawdź status istniejącego wniosku,
        aby ustalić dalszy przebieg jego rozpatrywania.</p>
      `,
    };
  }

  const operationMessage =
    action === 'SET'
      ? 'Wniosek o zmianę wartości atrybutu został utworzony.'
      : 'Wniosek o usunięcie wartości atrybutu został utworzony.';

  return {
    title: 'Wniosek został wysłany do zatwierdzenia',
    html: `
      <p>${operationMessage}</p>
      ${createAttributeDetails(data)}
      <p>Wartość atrybutu nie została jeszcze zmieniona.
      Czynność zostanie wykonana po zatwierdzeniu wniosku.</p>
      <p>Status możesz sprawdzić w szczegółach wniosku.</p>
    `,
  };
}

