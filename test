 // ENTITIES
import { Grant, GRANT_FIELDS } from '@entities/grant';

// AG-GRID
import type {
  ColDef,
  GridOptions,
  RowModelType,
} from 'ag-grid-community';

// GLOBAL CONFIGURATIONS
import {
  defaultServerSideColDef,
  defaultPaginationPageSizeSelector,
  defaultGridOptions,
  defaultPaginationPageSize,
  defaultCacheBlockSize,
  defaultServerSideTableToolbar,
  defaultSideBar,
} from '@shared/ui/ag-grid/ag-grid-table.config';

const fields = Object.keys(GRANT_FIELDS) as Array<
  keyof typeof GRANT_FIELDS
>;

const colDefs: ColDef<Grant>[] = fields.map((field) => ({
  field,
  width: GRANT_FIELDS[field]?.columnWidth ?? 200,
  headerName: GRANT_FIELDS[field]?.label ?? field,
  headerTooltip: field,
}));

const gridOptions: Partial<GridOptions<Grant>> = {
  ...defaultGridOptions,
};

const agGridConfig = {
  colDefs,
  defaultColDef: defaultServerSideColDef,
  sideBar: defaultSideBar,
  gridOptions,
  pagination: true,
  paginationPageSize: defaultPaginationPageSize,
  cacheBlockSize: defaultCacheBlockSize,
  paginationPageSizeSelector: defaultPaginationPageSizeSelector,
  toolbar: defaultServerSideTableToolbar,
  rowModelType: 'serverSide' as RowModelType,
};

export { agGridConfig };











// ANGULAR
import {
  Component,
  inject,
  TemplateRef,
  viewChild,
} from '@angular/core';

// ENTITIES
import {
  Grant,
  GRANT_FIELDS,
  GrantQueriesApi,
  GrantsQueryDto,
} from '@entities/grant';

// CONFIGURATION
import { agGridConfig } from './configuration/table.config';

// AG-GRID
import { AgGridAngular } from 'ag-grid-angular';
import { GridReadyEvent } from 'ag-grid-community';

// TABLE
import { createDatabaseSource } from '@shared/table';

// API
import type { ApiPaginatedQueryParams } from '@shared/api';

// UI
import { collapsibleToastByTemplateConfig } from '@shared/ui/mt-toast/mt-toast.config';

// ERROR
import {
  generateToastErrorHtml,
  mapErrorToUiError,
} from '@shared/error';

// TOAST
import { MtToastsService } from '@citi-icg-172888/ng-icgds';
import { MtToastTemplateContext } from '@citi-icg-172888/ng-icgds/toasts';

@Component({
  selector: 'app-grants-overview-widget',
  imports: [AgGridAngular],
  templateUrl: './ui/grants-overview.widget.html',
  styleUrl: './ui/styles/grants-overview.widget.css',
})
export class GrantsOverviewWidget {
  private readonly grantQueriesApi = inject(GrantQueriesApi);
  private readonly toastSvc = inject(MtToastsService);

  protected readonly agGridConfig = agGridConfig;

  private readonly toastRef =
    viewChild.required<TemplateRef<MtToastTemplateContext>>('toastTmpl');

  protected onGridReady(params: GridReadyEvent<Grant>): void {
    params.api.setGridOption(
      'serverSideDatasource',
      createDatabaseSource<Grant, GrantsQueryDto>({
        queryParams: (queryParams: ApiPaginatedQueryParams) =>
          this.grantQueriesApi.getGrants(queryParams),

        error: (err: unknown) => {
          const uiError = mapErrorToUiError(
            err,
            'Nie udało się pobrać listy uprawnień',
          );

          this.toastSvc.error(
            collapsibleToastByTemplateConfig(
              uiError.title,
              this.toastRef(),
              generateToastErrorHtml(uiError),
            ),
          );
        },
      }),
    );
  }
}








<ag-grid-angular
