import { Injectable } from '@angular/core';

import type { UiError } from '@shared/error';

import {
  NotificationDialogBase,
  type NotificationMessage,
} from '@shared/notifications';

import {
  UPDATE_ROW_DIALOG_CONFIG,
  UPDATE_ROW_HTTP_ERROR_MESSAGES,
  UPDATE_ROW_SUCCESS_MESSAGES,
  createUpdateRowConfirmation,
  type UpdateRowConfirmationData,
} from './update-row.notifications';

@Injectable({ providedIn: 'root' })
export class UpdateRowDialogService
  extends NotificationDialogBase<'UPDATE'> {

  constructor() {
    super(UPDATE_ROW_DIALOG_CONFIG);
  }

  openUpdateConfirmation(
    data: UpdateRowConfirmationData,
    onAccept: () => void,
    onReject: () => void,
  ): void {
    this.openConfirmationMessage(
      createUpdateRowConfirmation(data),
      onAccept,
      onReject,
    );
  }

  openSuccess(created: boolean): void {
    this.openAlert(
      'success',
      created
        ? UPDATE_ROW_SUCCESS_MESSAGES.CREATED
        : UPDATE_ROW_SUCCESS_MESSAGES.ALREADY_CREATED,
    );
  }

  protected override getFallbackErrorMessage(
    errorCode: UiError['errorCode'],
  ): NotificationMessage {
    switch (errorCode) {
      case 401:
        return UPDATE_ROW_HTTP_ERROR_MESSAGES.AUTHENTICATION_REQUIRED;

      case 429:
        return UPDATE_ROW_HTTP_ERROR_MESSAGES.RATE_LIMITED;

      case 500:
        return UPDATE_ROW_HTTP_ERROR_MESSAGES.SERVER_ERROR;

      case 503:
        return UPDATE_ROW_HTTP_ERROR_MESSAGES.SERVICE_UNAVAILABLE;

      default:
        return super.getFallbackErrorMessage(errorCode);
    }
  }
}







import { inject, Injectable } from '@angular/core';
import { finalize } from 'rxjs';

import {
  RowEditCommandsApi,
  type RowEditRequest,
  type RowEditRequestPayload,
  type RowEditTarget,
} from '@entities/row-edit';

import { MtLoaderService } from '@citi-icg-172888/ng-icgds';

import type {
  ChangedFields,
  UpdateRowConfig,
  UpdateRowPayload,
} from './model/update-row.model';

import {
  UpdateRowDialogService,
} from './model/update-row-dialog.service';

import {
  createNewValuesToSubmit,
  getChangedFields,
} from './model/update-row.utils';

@Injectable({ providedIn: 'root' })
export class UpdateRowFeature {
  private readonly rowEditApiService = inject(RowEditCommandsApi);
  private readonly loaderService = inject(MtLoaderService);
  private readonly dialogService = inject(UpdateRowDialogService);

  handle<T extends Record<string, unknown>>(
    payload: UpdateRowPayload<T>,
    config: UpdateRowConfig<T>,
  ): void {
    const changedFields = getChangedFields<T>(
      payload.original,
      payload.updated,
      config.fieldNames,
    );

    if (changedFields.length === 0) {
      return;
    }

    this.dialogService.openUpdateConfirmation(
      {
        recordIdLabel:
          config.fieldNames[config.recordIdFieldName]?.label
          ?? 'ID rekordu',

        recordId: String(
          payload.original[config.recordIdFieldName],
        ),

        fields: changedFields.map(field => ({
          label:
            config.fieldNames[field.name]?.label
            ?? String(field.name),

          oldValue: field.oldValue,
          newValue: field.newValue,
        })),
      },
      () => this.submit(payload, config, changedFields),
      () => payload.onError(),
    );
  }

  private submit<T extends Record<string, unknown>>(
    payload: UpdateRowPayload<T>,
    config: UpdateRowConfig<T>,
    changedFields: ChangedFields<T>,
  ): void {
    const keyColumnName = payload.targetMetadata.keyColumns[0];
    const versionColumnName = payload.targetMetadata.versionColumn;

    if (!keyColumnName || !versionColumnName) {
      this.dialogService.openInvalidPayload();
      payload.onError();
      return;
    }

    const keyColumn = keyColumnName.toLowerCase();
    const versionColumn = versionColumnName.toLowerCase();

    if (
      !(keyColumn in payload.updated) ||
      !(versionColumn in payload.updated)
    ) {
      this.dialogService.openInvalidPayload();
      payload.onError();
      return;
    }

    const pkValue = Number(payload.updated[keyColumn]);
    const expectedVersion = Number(payload.updated[versionColumn]);

    if (
      !Number.isFinite(pkValue) ||
      !Number.isFinite(expectedVersion)
    ) {
      this.dialogService.openInvalidPayload();
      payload.onError();
      return;
    }

    const newValues = createNewValuesToSubmit<T>(
      payload.updated,
      payload.targetMetadata,
      changedFields,
    );

    this.loaderService.show();

    this.sendUpdate(
      {
        newValues,
        pkValue,
        expectedVersion,
      },
      config.targetCode,
    )
      .pipe(
        finalize(() => this.loaderService.hide()),
      )
      .subscribe({
        next: ({ data }) => {
          this.dialogService.openSuccess(data.created);
          payload.onSuccess();
        },

        error: (error: unknown) => {
          this.dialogService.openResponseError(error);
          payload.onError();
        },
      });
  }

  private sendUpdate<T extends string = string>(
    payload: RowEditRequestPayload<T>,
    rowEditTarget: RowEditTarget,
  ) {
    const request: RowEditRequest = {
      targetCode: rowEditTarget,
      clientKey: crypto.randomUUID(),
      keepOther: true,
      rows: [
        {
          pkValue: String(payload.pkValue),
          expectedVersion: payload.expectedVersion,
          newValues: payload.newValues,
        },
      ],
    };

    return this.rowEditApiService.submitChanges(request);
  }
}

export type { UpdateRowConfig };
