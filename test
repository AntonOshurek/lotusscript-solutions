openResponseError(
  err: unknown,
  _decisionKind: GovernanceDecisionKind,
): void {
  const uiError = mapErrorToUiError(err);
  const detail = uiError.backendError?.detail;

  const message =
    typeof detail === 'string'
      ? DECISION_ERROR_MESSAGES[detail]
      : undefined;

  this.openAlert(
    'danger',
    message ?? this.getFallbackErrorMessage(uiError.errorCode),
  );
}

openInvalidPayload(
  _decisionKind: GovernanceDecisionKind,
): void {
  this.openAlert('danger', {
    title: 'Nie można zapisać decyzji',
    html: `
      <p>Nie udało się przygotować decyzji do zapisania.
      Decyzja nie została wysłana.</p>
      <p>Odśwież wniosek i spróbuj ponownie.
      Jeśli problem się powtarza, skontaktuj się z administratorem.</p>
    `,
  });
}

openSuccess(
  decisionKind: GovernanceDecisionKind,
  data: GovernanceCaseDecisionResponse,
): void {
  if (data.phase === 'INCIDENT') {
    this.openAlert('warning', {
      title: 'Zmiana wymaga dodatkowej obsługi',
      html: `
        <p>Twoja decyzja została zapisana, ale podczas realizacji
        zmiany wystąpił problem.</p>
        <p>Wniosek oczekuje na obsługę przez uprawnioną osobę.
        Nie wysyłaj ponownie tej samej decyzji ani nowego wniosku
        dotyczącego tej zmiany.</p>
        <p>Sprawdzaj status wniosku. Jeśli potrzebujesz wyjaśnień,
        skontaktuj się z osobą obsługującą incydenty
        lub administratorem.</p>
      `,
    });
    return;
  }

  if (data.outcome === 'CONFLICT_REFUSED') {
    this.openAlert('warning', {
      title: 'Zmiana nie została wprowadzona',
      html: `
        <p>Twoja decyzja została zapisana, ale zmiana nie mogła
        zostać wprowadzona. Wniosek został zakończony,
        a dane, których dotyczyła zmiana, pozostały bez zmian.</p>
        <p>Sprawdź aktualne dane oraz przyczynę zakończenia
        w szczegółach wniosku. Jeśli zmiana nadal jest potrzebna,
        zgłoś nowy wniosek uwzględniający aktualny stan danych.</p>
      `,
    });
    return;
  }

  if (data.outcome === 'SUCCEEDED') {
    this.openAlert('success', {
      title: SUCCESS_MAKE_DECISION_NOTIFICATION[decisionKind].title,
      html: SUCCESS_MAKE_DECISION_NOTIFICATION[decisionKind].html,
    });
    return;
  }

  this.openAlert('warning', {
    title: 'Decyzja została zapisana',
    html: `
      <p>Twoja decyzja została zapisana.
      Sprawdź aktualny status wniosku, aby ustalić,
      czy wymaga on dalszego rozpatrzenia lub obsługi.</p>
      <p>Nie wysyłaj ponownie tej samej decyzji.</p>
    `,
  });
}

private getFallbackErrorMessage(
  errorCode: UiError['errorCode'],
): DecisionMessage {
  switch (errorCode) {
    case 400:
      return {
        title: 'Nie można wykonać tej czynności',
        html: `
          <p>Nie udało się wykonać wybranej czynności.
          Dane wniosku lub wybrana czynność wymagają sprawdzenia.</p>
          <p>Odśwież wniosek i sprawdź jego dane.
          Jeśli problem nadal występuje,
          skontaktuj się z administratorem.</p>
        `,
      };

    case 403:
      return DECISION_ERROR_MESSAGES['GOV_NOT_ELIGIBLE'];

    case 409:
      return {
        title: 'Nie można wykonać tej czynności',
        html: `
          <p>Wybrana czynność nie może zostać wykonana
          przy obecnym stanie wniosku lub powiązanych danych.</p>
          <p>Odśwież wniosek i sprawdź dostępne działania.
          Jeśli problem nadal występuje,
          skontaktuj się z administratorem.</p>
        `,
      };

    default:
      return {
        title: 'Nie udało się potwierdzić wykonania czynności',
        html: `
          <p>Wystąpił nieoczekiwany problem.
          Nie udało się potwierdzić, czy wybrana czynność
          została wykonana.</p>
          <p>Odśwież wniosek i sprawdź jego status oraz zapisane
          decyzje przed ponowną próbą.
          Jeśli problem nadal występuje,
          skontaktuj się z administratorem.</p>
        `,
      };
  }
}

private openAlert(
  status: 'danger' | 'warning' | 'success',
  message: DecisionMessage,
): void {
  this.modalService.open({
    status,
    title: message.title,
    html: message.html,
    type: 'alert',
  });
}
