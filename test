import { HttpErrorResponse } from '@angular/common/http';
import { ZodError } from 'zod';

import type { UiError } from '../model/ui-error.model';

import { parseApiErrorToUi } from './api-error.mapper';

const DEFAULT_ERROR_TITLE =
  'Nie udało się wykonać operacji';

const UNEXPECTED_ERROR_MESSAGE =
  'Wystąpił nieoczekiwany problem. ' +
  'Jeśli problem się powtarza, skontaktuj się z administratorem.';

const mapErrorToUiError = (
  error: unknown,
  fallbackTitle: string = DEFAULT_ERROR_TITLE,
): UiError => {
  if (error instanceof HttpErrorResponse) {
    return parseApiErrorToUi(error, fallbackTitle);
  }

  if (error instanceof ZodError) {
    return {
      title: fallbackTitle,

      message:
        'Nie udało się przetworzyć danych, ' +
        'ponieważ mają nieoczekiwany format. ' +
        'Jeśli problem się powtarza, ' +
        'skontaktuj się z administratorem.',

      details: error.issues.map(issue => {
        const path = issue.path.map(String).join('.') || '(root)';

        return `Path: ${path}; Code: ${issue.code}`;
      }),

      errorCode: 0,
    };
  }

  if (error instanceof Error) {
    return {
      title: fallbackTitle,
      message: UNEXPECTED_ERROR_MESSAGE,

      details: [
        `Name: ${error.name}`,
        `Message: ${error.message}`,
      ],

      errorCode: 0,
    };
  }

  return {
    title: fallbackTitle,
    message: UNEXPECTED_ERROR_MESSAGE,
    details: [],
    errorCode: 0,
  };
};

const escapeHtml = (value: string): string => {
  return value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
};

const generateToastErrorHtml = (
  uiError: UiError,
): string => {
  const title = escapeHtml(uiError.title);
  const message = escapeHtml(uiError.message);

  const requestIdHtml = uiError.requestId
    ? `
      <p>
        Identyfikator zgłoszenia:
        <code>${escapeHtml(uiError.requestId)}</code>
      </p>
    `
    : '';

  return `
    <div>
      <p>
        <i class="lmnicon lmnicon-alert-triangle lmn-text-color-warning"></i>
        <strong>${title}</strong>
      </p>

      <p>${message}</p>

      ${requestIdHtml}
    </div>
  `;
};

export {
  mapErrorToUiError,
  generateToastErrorHtml,
};  
