openConfirmation(
  action: TAction,
  onAccept: () => void,
): void {
  this.openConfirmationMessage(
    this.config.confirmation[action],
    onAccept,
  );
}

protected openConfirmationMessage(
  message: NotificationMessage,
  onAccept: () => void,
  onReject?: () => void,
): void {
  this.modalService.open({
    status: 'warning',
    title: message.title,
    html: message.html,
    type: 'confirm',
    afterUserAction: event => {
      if (event.action === 'accept') {
        onAccept();
        return;
      }

      onReject?.();
    },
  });
}







