      'lub parametrów. Sprawdź wprowadzone dane i spróbuj ponownie.',

    401:
      'Nie udało się potwierdzić Twojego zalogowania. ' +
      'Odśwież stronę. Jeśli pojawi się ekran logowania, zaloguj się ponownie.',

    403:
      'Nie masz uprawnień do wykonania tej czynności ' +
      'lub dostępu do wybranych danych.',

    404:
      'Nie znaleziono wskazanych danych. ' +
      'Odśwież listę i sprawdź, czy wybrany element jest nadal dostępny.',

    408:
      'Przekroczono czas oczekiwania na obsługę żądania. ' +
      'Spróbuj ponownie za chwilę.',

    409:
      'Żądanie koliduje z aktualnym stanem danych. ' +
      'Odśwież dane i sprawdź dostępne działania.',

    422:
      'Przesłane dane nie spełniają wymagań. ' +
      'Sprawdź wprowadzone wartości.',

    429:
      'Wysłano zbyt wiele żądań w krótkim czasie. ' +
      'Odczekaj chwilę i spróbuj ponownie.',

    500:
      'Podczas obsługi żądania wystąpił problem po stronie systemu. ' +
      'Jeśli problem się powtarza, skontaktuj się z administratorem.',

    502:
      'Wystąpił problem komunikacji między usługami. ' +
      'Spróbuj ponownie za chwilę.',

    503:
      'Usługa jest chwilowo niedostępna. ' +
      'Spróbuj ponownie później.',

    504:
      'Przekroczono czas oczekiwania na odpowiedź usługi. ' +
      'Spróbuj ponownie za chwilę.',
  };

const UNEXPECTED_HTTP_ERROR_MESSAGE =
  'Nie udało się obsłużyć żądania. ' +
  'Jeśli problem się powtarza, skontaktuj się z administratorem.';

const isRecord = (
  value: unknown,
): value is Record<string, unknown> => {
  return (
    typeof value === 'object' &&
    value !== null &&
    !Array.isArray(value)
  );
};

const readString = (value: unknown): string | undefined => {
  return typeof value === 'string' ? value : undefined;
};

const parseViolations = (
  value: unknown,
): ViolationsBackendError[] => {
  if (!Array.isArray(value)) {
    return [];
  }

  return value.filter(
    (item): item is ViolationsBackendError =>
      isRecord(item) &&
      typeof item['field'] === 'string' &&
      typeof item['message'] === 'string',
  );
};

const parseBackendError = (
  body: unknown,
  httpStatus: number,
): BackendError | undefined => {
  let value: unknown = body;

  if (typeof value === 'string') {
    try {
      value = JSON.parse(value);
    } catch {
      return undefined;
    }
  }

  if (!isRecord(value)) {
    return undefined;
  }

  const code = readString(value['code']);
  const detail = readString(value['detail']);
  const title = readString(value['title']);
  const message = readString(value['message']);

  // Не считаем произвольный JSON стандартной ошибкой backend.
  if (
    code === undefined &&
    detail === undefined &&
    title === undefined &&
    message === undefined
  ) {
    return undefined;
  }

  return {
    type: readString(value['type']),
    title,
    instance: readString(value['instance']),

    status:
      typeof value['status'] === 'number' &&
      Number.isFinite(value['status'])
        ? value['status']
        : httpStatus,

    code: code ?? '',
    detail: detail ?? '',
    message: message ?? '',
    violations: parseViolations(value['violations']),
  };
};

const parseApiErrorToUi = (
  error: HttpErrorResponse,
  title: string,
): UiError => {
  const backendError = parseBackendError(
    error.error,
    error.status,
  );

  const requestId =
    error.headers.get('X-Request-Id')?.trim() ||
    error.headers.get('X-Trace-Id')?.trim() ||
    undefined;

  const message =
    error.status >= 200 && error.status < 300
      ? 'Serwer zwrócił odpowiedź, której nie udało się odczytać. ' +
        'Odśwież dane. Jeśli problem się powtarza, ' +
        'skontaktuj się z administratorem.'
      : HTTP_ERROR_MESSAGES[error.status] ??
        UNEXPECTED_HTTP_ERROR_MESSAGE;

  return {
    title,
    message,
    errorCode: error.status,
    backendError,
    requestId,
  };
};

export { parseApiErrorToUi };





