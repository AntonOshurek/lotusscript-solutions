import {
  retry,
  throwError,
  timer,
  type MonoTypeOperatorFunction,
} from 'rxjs';

import { mapErrorToUiError } from '@shared/error';

const CONFLICT_RETRY_COUNT = 2;
const CONFLICT_RETRY_DELAY_MS = 500;

export function retryOnConflict<T>(
  detail: string,
): MonoTypeOperatorFunction<T> {
  return retry<T>({
    count: CONFLICT_RETRY_COUNT,

    delay: (error: unknown, retryCount: number) => {
      const uiError = mapErrorToUiError(error);

      const shouldRetry =
        uiError.errorCode === 409 &&
        uiError.backendError?.detail === detail;

      if (!shouldRetry) {
        return throwError(() => error);
      }

      return timer(
        CONFLICT_RETRY_DELAY_MS * retryCount,
      );
    },
  });
}




