import { Injectable } from '@angular/core';

import type {
  GovernanceCaseDecisionResponse,
} from '@entities/governance';

import {
  NotificationDialogBase,
} from '@shared/notifications';

import {
  CANCEL_CASE_DIALOG_CONFIG,
  CANCEL_CASE_RESULT_MESSAGES,
} from './cancel-case-notifications.model';

@Injectable()
export class CancelCaseDialogService
  extends NotificationDialogBase<'CANCEL'> {
  constructor() {
    super(CANCEL_CASE_DIALOG_CONFIG);
  }

  openSuccess(
    data: GovernanceCaseDecisionResponse,
  ): void {
    if (data.phase === 'INCIDENT') {
      this.openAlert(
        'warning',
        CANCEL_CASE_RESULT_MESSAGES.INCIDENT,
      );
      return;
    }

    if (
      data.phase === 'CLOSED' &&
      data.outcome === 'CONFLICT_REFUSED'
    ) {
      this.openAlert(
        'warning',
        CANCEL_CASE_RESULT_MESSAGES.CONFLICT_REFUSED,
      );
      return;
    }

    this.openAlert(
      'warning',
      CANCEL_CASE_RESULT_MESSAGES.UNCONFIRMED,
    );
  }
}
