shared/error/model/ui-error.model.ts

interface ViolationsBackendError {
  field: string;
  message: string;
}

interface BackendError {
  type?: string;
  title?: string;
  instance?: string;

  status: number;
  code: string;
  message: string;
  detail: string;
  violations: ViolationsBackendError[];
}

interface UiError {
  title: string;
  message: string;

  // Технические сведения. Не выводятся в обычном уведомлении.
  details?: string[];

  // HTTP-статус. Для ошибок вне HTTP сохраняем прежнее значение 0.
  errorCode: number;

  backendError?: BackendError;
  requestId?: string;
}

export type {
  BackendError,
  UiError,
  ViolationsBackendError,
};




