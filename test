public setPickerDate(value: Date | null): void {
  if (value === null) {
    this.resetDataDate();
    return;
  }

  const dataDate = this.formatPickerDate(value);

  if (dataDate === null) {
    this.openValidationError('Podaj prawidłową datę.');
    return;
  }

  this.setDataDate(dataDate);
}

private formatPickerDate(value: Date): string | null {
  if (Number.isNaN(value.getTime())) {
    return null;
  }

  const year = String(value.getFullYear()).padStart(4, '0');
  const month = String(value.getMonth() + 1).padStart(2, '0');
  const day = String(value.getDate()).padStart(2, '0');

  return `${year}-${month}-${day}`;
}
