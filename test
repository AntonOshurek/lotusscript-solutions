import { SearchGrantsComponent } from '../ui/search-grants/search-grants.component';
import type { SearchGrantsParams } from '../ui/search-grants/model/search-grants.model';

const createGrantsGridConfig = (
  onSearchChange: (query: string) => void,
) => {
  const toolbar = {
    items: [
      {
        key: 'grant-search',
        toolbarItem: SearchGrantsComponent,
        alignment: 'right' as const,
        toolbarItemParams: {
          onSearchChange,
        } as SearchGrantsParams,
      },
    ],
  };

  return {
    colDefs,
    defaultColDef: defaultServerSideColDef,
    sideBar: defaultSideBar,
    gridOptions,
    pagination: true,
    paginationPageSize: defaultPaginationPageSize,
    cacheBlockSize: defaultCacheBlockSize,
    paginationPageSizeSelector: defaultPaginationPageSizeSelector,
    toolbar,
    rowModelType: 'serverSide' as RowModelType,
  };
};

export { createGrantsGridConfig };





grants-overview.widget.ts


import { signal } from '@angular/core';
import type { GridApi } from 'ag-grid-community';

import { createGrantsGridConfig } from './configuration/table.config';



private readonly searchQuery = signal<string>('');

private gridApi: GridApi<Grant> | null = null;

protected readonly agGridConfig = createGrantsGridConfig(
  (query: string) => {
    if (this.searchQuery() === query) {
      return;
    }

    this.searchQuery.set(query);
    this.refreshGrid();
  },
);

private refreshGrid(): void {
  this.gridApi?.refreshServerSide({
    purge: true,
  });
}



protected onGridReady(params: GridReadyEvent<Grant>): void {
  this.gridApi = params.api;

  params.api.setGridOption(
    'serverSideDatasource',
    createDatabaseSource<Grant, GrantsQueryDto>({
      queryParams: (queryParams: ApiPaginatedQueryParams) =>
        this.grantQueriesApi.getGrants(queryParams, {
          q: this.searchQuery() || undefined,
        }),

      error: (err: unknown) => {
        const uiError = mapErrorToUiError(
          err,
          'Nie udało się pobrać listy uprawnień',
        );

        this.toastSvc.error(
          collapsibleToastByTemplateConfig(
            uiError.title,
            this.toastRef(),
            generateToastErrorHtml(uiError),
          ),
        );
      },
    }),
  );
}









