const { targetCode, keyColumns } = payload.targetMetadata;

if (!targetCode?.trim()) {
  this.abortByValidation(
    payload.onError,
    UPDATE_ROW_INVALID_PAYLOAD_REASONS.MISSING_TARGET,
  );
  return;
}

if (keyColumns.length !== 1) {
  this.abortByValidation(
    payload.onError,
    UPDATE_ROW_INVALID_PAYLOAD_REASONS.UNSUPPORTED_KEY,
  );
  return;
}

const keyColumnName = keyColumns[0];

if (!keyColumnName?.trim()) {
  this.abortByValidation(
    payload.onError,
    UPDATE_ROW_INVALID_PAYLOAD_REASONS.MISSING_KEY_COLUMN,
  );
  return;
}

const keyColumn = keyColumnName.toLowerCase();





const keyColumnName = payload.targetMetadata.keyColumns[0];
const versionColumnName = payload.targetMetadata.versionColumn;

if (!keyColumnName?.trim()) {
  this.abortByValidation(
    payload.onError,
    UPDATE_ROW_INVALID_PAYLOAD_REASONS.MISSING_KEY_COLUMN,
  );
  return;
}

if (!versionColumnName?.trim()) {
  this.abortByValidation(
    payload.onError,
    UPDATE_ROW_INVALID_PAYLOAD_REASONS.MISSING_VERSION_COLUMN,
  );
  return;
}

const keyColumn = keyColumnName.toLowerCase();
const versionColumn = versionColumnName.toLowerCase();

if (!Object.prototype.hasOwnProperty.call(payload.original, keyColumn)) {
  this.abortByValidation(
    payload.onError,
    UPDATE_ROW_INVALID_PAYLOAD_REASONS.MISSING_ID,
  );
  return;
}

if (!Object.prototype.hasOwnProperty.call(payload.original, versionColumn)) {
  this.abortByValidation(
    payload.onError,
    UPDATE_ROW_INVALID_PAYLOAD_REASONS.MISSING_VERSION,
  );
  return;
}

const originalPk = payload.original[keyColumn];
const originalVersion = payload.original[versionColumn];

if (
  originalPk == null ||
  (typeof originalPk === 'string' && originalPk.trim().length === 0)
) {
  this.abortByValidation(
    payload.onError,
    UPDATE_ROW_INVALID_PAYLOAD_REASONS.EMPTY_ID,
  );
  return;
}

if (
  originalVersion == null ||
  (typeof originalVersion === 'string' &&
    originalVersion.trim().length === 0)
) {
  this.abortByValidation(
    payload.onError,
    UPDATE_ROW_INVALID_PAYLOAD_REASONS.EMPTY_VERSION,
  );
  return;
}

const pkValue = Number(originalPk);
const expectedVersion = Number(originalVersion);

if (!Number.isFinite(pkValue)) {
  this.abortByValidation(
    payload.onError,
    UPDATE_ROW_INVALID_PAYLOAD_REASONS.INVALID_ID,
  );
  return;
}

if (!Number.isFinite(expectedVersion)) {
  this.abortByValidation(
    payload.onError,
    UPDATE_ROW_INVALID_PAYLOAD_REASONS.INVALID_VERSION,
  );
  return;
}
