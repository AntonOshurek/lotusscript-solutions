import type { ColDef } from 'ag-grid-community';
import type { FieldModel } from '@shared/field';

const createColumnDefs = <TData extends object>(
  fields: Partial<Record<Extract<keyof TData, string>, FieldModel>>,
): ColDef<TData>[] => {
  return Object.keys(fields).map((field): ColDef<TData> => {
    const config = fields[field as Extract<keyof TData, string>];

    return {
      field,
      headerName: config?.label ?? field,
      headerTooltip: field,
      width: config?.columnWidth ?? 200,
    };
  });
};

export { createColumnDefs };
