import {
  Component,
  DestroyRef,
  inject,
} from '@angular/core';
import { FormsModule } from '@angular/forms';
import {
  Subject,
  debounceTime,
  distinctUntilChanged,
} from 'rxjs';
import { takeUntilDestroyed } from '@angular/core/rxjs-interop';

// AG-GRID
import type { IToolbarItemAngularComp } from 'ag-grid-angular';
import type { IToolbarItemParams } from 'ag-grid-community';

// ENTITIES
import type { Grant } from '@entities/grant';

// MODEL
import type { SearchGrantsParams } from './model/search-grants.model';

@Component({
  selector: 'app-search-grants',
  imports: [FormsModule],
  templateUrl: './search-grants.component.html',
})
export class SearchGrantsComponent
  implements IToolbarItemAngularComp
{
  private readonly destroyRef = inject(DestroyRef);

  private params!: IToolbarItemParams<
    Grant,
    unknown,
    SearchGrantsParams
  >;

  private readonly searchChanges = new Subject<string>();

  public searchValue = '';

  constructor() {
    this.searchChanges
      .pipe(
        debounceTime(300),
        distinctUntilChanged(),
        takeUntilDestroyed(this.destroyRef),
      )
      .subscribe((query) => {
        this.params.toolbarItemParams.onSearchChange(query);
      });
  }

  public agInit(
    params: IToolbarItemParams<
      Grant,
      unknown,
      SearchGrantsParams
    >,
  ): void {
    this.params = params;
  }

  public onSearchChange(value: string): void {
    this.searchValue = value;
    this.searchChanges.next(value.trim());
  }
}









