import { inject, Injectable } from '@angular/core';

// ENTITIES
import {
  GOVERNANCE_OUTCOME_LABEL,
  GOVERNANCE_PHASE_LABEL,
} from '@entities/governance';
import type { GovernanceResponseDto } from '@entities/governance';

// MODEL
import { ERROR_CANCEL_CASE_NOTIFICATIONS } from './cancel-case-notifications.model';

// ERROR
import type { UiError } from '@shared/error';

// ICG
import { MtModalService } from '@citi-icg-172888/ng-icgds/modal';

@Injectable()
export class CancelCaseDialogService {
  private readonly modalService = inject(MtModalService);

  openInvalidPayload(): void {
    const notification =
      ERROR_CANCEL_CASE_NOTIFICATIONS.CANCEL_CASE_PAYLOAD_UNDEFINED;

    this.modalService.open({
      status: 'danger',
      title: notification.title,
      html: notification.html(),
      type: 'alert',
    });
  }

  openConfirmation(onAccept: () => void): void {
    this.modalService.open({
      status: 'warning',
      title: 'Potwierdź anulowanie',
      html: 'Czy na pewno chcesz anulować ten wniosek o zmianę?',
      type: 'confirm',
      afterUserAction: (event) => {
        if (event.action === 'accept') {
          onAccept();
        }
      },
    });
  }

  openSuccess(data: GovernanceResponseDto): void {
    this.modalService.open({
      status: 'success',
      title: 'Operacja zakończona pomyślnie.',
      html: this.getResultHtml(data),
      type: 'alert',
    });
  }

  openUnsuccessfulResult(data: GovernanceResponseDto): void {
    this.modalService.open({
      status: 'warning',
      title: 'Operacja nie została zakończona pomyślnie.',
      html: this.getResultHtml(data),
      type: 'alert',
    });
  }

  openConflictError(uiError: UiError): void {
    const notification =
      ERROR_CANCEL_CASE_NOTIFICATIONS.CANCEL_CASE_SUBMIT_FAILED_BY_CONFLICT;

    this.modalService.open({
      status: 'danger',
      title: notification.title,
      html: notification.html({
        uiError,
      }),
      type: 'alert',
    });
  }

  openSubmitError(uiError: UiError): void {
    const notification =
      ERROR_CANCEL_CASE_NOTIFICATIONS.CANCEL_CASE_SUBMIT_FAILED;

    this.modalService.open({
      status: 'danger',
      title: notification.title,
      html: notification.html({
        uiError,
      }),
      type: 'alert',
    });
  }

  private getResultHtml(data: GovernanceResponseDto): string {
    return `
      <div>
        <p>Wynik: ${
          GOVERNANCE_OUTCOME_LABEL[data.outcome] ?? data.outcome
        }</p>
        <p>Etap: ${
          GOVERNANCE_PHASE_LABEL[data.phase] ?? data.phase
        }</p>
      </div>
    `;
  }
}




import { inject, Injectable } from '@angular/core';

// ENTITIES
import {
  GovernanceCommandsApi,
} from '@entities/governance';
import type {
  GovernanceCaseCancelRequestDto,
  GovernanceResponseDto,
} from '@entities/governance';

// MODEL
import type { CancelCaseFeaturePayload } from './model/cancel-case.model';
import { CancelCaseDialogService } from './model/cancel-case-dialog.service';

// ERROR
import { mapErrorToUiError } from '@shared/error';

@Injectable({
  providedIn: 'root',
})
export class CancelCaseFeature {
  private readonly governanceCommandsApi =
    inject(GovernanceCommandsApi);

  private readonly dialogService =
    inject(CancelCaseDialogService);

  cancel(payload: CancelCaseFeaturePayload | null | undefined): void {
    if (!payload) {
      this.dialogService.openInvalidPayload();
      return;
    }

    this.dialogService.openConfirmation(() => {
      this.runCancel(payload);
    });
  }

  private runCancel(payload: CancelCaseFeaturePayload): void {
    this.sendCancel(payload).subscribe({
      next: ({ data }: { data: GovernanceResponseDto }) => {
        if (data.outcome === 'SUCCEEDED') {
          this.dialogService.openSuccess(data);
          return;
        }

        this.dialogService.openUnsuccessfulResult(data);
      },

      error: (error: unknown) => {
        const uiError = mapErrorToUiError(error);

        if (uiError.errorCode === 409) {
          this.dialogService.openConflictError(uiError);
          return;
        }

        this.dialogService.openSubmitError(uiError);
      },
    });
  }

  private sendCancel(
    payload: CancelCaseFeaturePayload,
  ) {
    const requestBody: GovernanceCaseCancelRequestDto = {
      expectedCaseVersion: payload.expectedCaseVersion,
      reason: payload.reason,
    };

    return this.governanceCommandsApi.caseCancel(
      requestBody,
      payload.caseId,
    );
  }
}
