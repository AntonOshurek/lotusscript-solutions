import { inject, Injectable } from '@angular/core';

import {
  defer,
  finalize,
  retry,
  throwError,
  timer,
} from 'rxjs';

import {
  GovernanceCommandsApi,
  GovernanceRefreshEvent,
} from '@entities/governance';

import { mapErrorToUiError } from '@shared/error';

import {
  MtLoaderService,
} from '@citi-icg-172888/ng-icgds';

import {
  CaseDecisionDialogService,
} from './model/case-decision-dialog.service';

import type {
  DecideProps,
  MakeDecisionFeaturePayload,
} from './model/case-decision.model';

const RESOURCE_BUSY_RETRY_COUNT = 2;
const RESOURCE_BUSY_RETRY_DELAY_MS = 500;

@Injectable()
export class CaseDecisionFeature {
  private readonly loaderService = inject(MtLoaderService);

  private readonly governanceCommandsApi =
    inject(GovernanceCommandsApi);

  private readonly dialogService =
    inject(CaseDecisionDialogService);

  private readonly governanceRefreshEvent =
    inject(GovernanceRefreshEvent);

  public decide({
    reason,
    precomputedPayload,
    decisionKind,
  }: DecideProps): void {
    if (!precomputedPayload) {
      this.dialogService.openInvalidPayload();
      return;
    }

    const payload: MakeDecisionFeaturePayload = {
      ...precomputedPayload,
      kind: decisionKind,
      reason,
    };

    this.dialogService.openConfirmation(
      decisionKind,
      () => this.sendDecision(payload),
    );
  }

  private sendDecision(
    payload: MakeDecisionFeaturePayload,
  ): void {
    this.loaderService.show();

    defer(() =>
      this.governanceCommandsApi.caseDecision(
        payload,
        payload.caseId,
      ),
    )
      .pipe(
        retry({
          count: RESOURCE_BUSY_RETRY_COUNT,

          delay: (error: unknown, retryCount: number) => {
            const uiError = mapErrorToUiError(error);

            const isResourceBusy =
              uiError.errorCode === 409 &&
              uiError.backendError?.detail ===
                'GOV_RESOURCE_BUSY';

            if (!isResourceBusy) {
              return throwError(() => error);
            }

            return timer(
              RESOURCE_BUSY_RETRY_DELAY_MS * retryCount,
            );
          },
        }),

        finalize(() => {
          this.loaderService.hide();
        }),
      )
      .subscribe({
        next: ({ data }) => {
          this.governanceRefreshEvent.refreshCase(
            +payload.caseId,
          );

          this.dialogService.openSuccess(
            payload.kind,
            data,
          );
        },

        error: (error: unknown) => {
          this.governanceRefreshEvent.refreshCase(
            +payload.caseId,
          );

          this.dialogService.openResponseError(error);
        },
      });
  }
}
