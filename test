import { inject, Injectable } from '@angular/core';
import { HttpClient } from '@angular/common/http';
import { map } from 'rxjs';

// DTO
import { GrantsQueryDtoSchema } from './grantQueryDtoSchema';

// API
import {
  ABAC_ENDPOINTS,
  type ApiPaginatedQueryParams,
  mapFetchDataQueryParams,
} from '@shared/api';

type GrantQueryFilters = {
  subjectCode?: string;
  resourceCode?: string;
  actionCode?: string;
  q?: string;
  sort?: string[];
};

@Injectable()
export class GrantQueriesApi {
  private readonly http = inject(HttpClient);

  public getGrants(
    queryParams: ApiPaginatedQueryParams,
    filters: GrantQueryFilters = {},
  ) {
    const params = {
      ...mapFetchDataQueryParams(queryParams),
      ...(filters.subjectCode !== undefined && {
        subjectCode: filters.subjectCode,
      }),
      ...(filters.resourceCode !== undefined && {
        resourceCode: filters.resourceCode,
      }),
      ...(filters.actionCode !== undefined && {
        actionCode: filters.actionCode,
      }),
      ...(filters.q !== undefined && {
        q: filters.q,
      }),
      ...(filters.sort !== undefined && {
        sort: filters.sort,
      }),
    };

    return this.http
      .get<unknown>(ABAC_ENDPOINTS.GET_GRANTS, {
        params,
      })
      .pipe(
        map((response: unknown) =>
          GrantsQueryDtoSchema.parse(response),
        ),
      );
  }
}

export type { GrantQueryFilters };









// MODEL
export { GrantSchema } from './model/grant.model';
export type { Grant } from './model/grant.model';
export { GRANT_FIELDS } from './model/grant-fields.model';

// API
export { GrantQueriesApi } from './api/grant.queries.api';
export { GrantsQueryDtoSchema } from './api/grantQueryDtoSchema';
export type { GrantsQueryDto } from './api/grantQueryDtoSchema';
export type { GrantQueryFilters } from './api/grant.queries.api';
