openSuccess(
  decisionKind: GovernanceDecisionKind,
  data: GovernanceCaseDecisionResponse,
): void {
  const { phase, outcome } = data;

  if (phase === 'CLOSED') {
    if (outcome === 'CONFLICT_REFUSED') {
      this.openAlert(
        'warning',
        DECISION_RESULT_MESSAGES.CONFLICT_REFUSED,
      );
      return;
    }

    if (outcome === 'FAILED_ABANDONED') {
      this.openAlert(
        'warning',
        DECISION_RESULT_MESSAGES.FAILED_ABANDONED,
      );
      return;
    }

    if (outcome === 'NO_EFFECT_COMPLETED') {
      this.openAlert(
        'warning',
        DECISION_RESULT_MESSAGES.NO_EFFECT_COMPLETED,
      );
      return;
    }

    if (
      decisionKind === 'APPROVE' &&
      outcome === 'SUCCEEDED'
    ) {
      this.openAlert(
        'success',
        DECISION_RESULT_MESSAGES.APPLIED,
      );
      return;
    }

    if (
      decisionKind === 'REJECT' &&
      outcome === 'REJECTED'
    ) {
      this.openAlert(
        'success',
        SUCCESS_MAKE_DECISION_NOTIFICATION.REJECT,
      );
      return;
    }
  }

  if (outcome == null) {
    if (phase === 'INCIDENT') {
      this.openAlert(
        'warning',
        DECISION_RESULT_MESSAGES.INCIDENT,
      );
      return;
    }

    if (
      decisionKind === 'APPROVE' &&
      [
        'IN_REVIEW',
        'APPROVED',
        'SCHEDULED',
        'EXECUTING',
        'WAITING_EXTERNAL',
      ].includes(phase)
    ) {
      this.openAlert(
        'success',
        DECISION_RESULT_MESSAGES.RECORDED,
      );
      return;
    }

    if (
      decisionKind === 'REJECT' &&
      phase === 'RETURNED'
    ) {
      this.openAlert(
        'success',
        DECISION_RESULT_MESSAGES.RECORDED,
      );
      return;
    }

    if (
      decisionKind === 'WITHDRAW' &&
      phase === 'IN_REVIEW'
    ) {
      this.openAlert(
        'success',
        SUCCESS_MAKE_DECISION_NOTIFICATION.WITHDRAW,
      );
      return;
    }
  }

  this.openAlert(
    'warning',
    DECISION_RESULT_MESSAGES.UNCONFIRMED,
  );
}




