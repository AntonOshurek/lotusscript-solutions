import {
  DECISION_ERROR_MESSAGES,
  DECISION_RESULT_MESSAGES,
  FALLBACK_DECISION_ERROR_MESSAGES,
  INVALID_DECISION_MESSAGE,
  SUCCESS_MAKE_DECISION_NOTIFICATION,
} from './case-decision-notifications.model';

import type {
  DecisionMessage,
} from './case-decision-notifications.model';





openResponseError(
  err: unknown,
  _decisionKind: GovernanceDecisionKind,
): void {
  const uiError = mapErrorToUiError(err);
  const detail = uiError.backendError?.detail;

  const message =
    typeof detail === 'string'
      ? DECISION_ERROR_MESSAGES[detail]
      : undefined;

  this.openAlert(
    'danger',
    message ?? this.getFallbackErrorMessage(uiError.errorCode),
  );
}

openInvalidPayload(
  _decisionKind: GovernanceDecisionKind,
): void {
  this.openAlert('danger', INVALID_DECISION_MESSAGE);
}

openSuccess(
  decisionKind: GovernanceDecisionKind,
  data: GovernanceCaseDecisionResponse,
): void {
  if (data.phase === 'INCIDENT') {
    this.openAlert('warning', DECISION_RESULT_MESSAGES.INCIDENT);
    return;
  }

  if (data.outcome === 'CONFLICT_REFUSED') {
    this.openAlert(
      'warning',
      DECISION_RESULT_MESSAGES.CONFLICT_REFUSED,
    );
    return;
  }

  if (data.outcome === 'SUCCEEDED') {
    this.openAlert(
      'success',
      SUCCESS_MAKE_DECISION_NOTIFICATION[decisionKind],
    );
    return;
  }

  this.openAlert('warning', DECISION_RESULT_MESSAGES.RECORDED);
}

private getFallbackErrorMessage(
  errorCode: UiError['errorCode'],
): DecisionMessage {
  switch (errorCode) {
    case 400:
      return FALLBACK_DECISION_ERROR_MESSAGES.INVALID_REQUEST;

    case 403:
      return FALLBACK_DECISION_ERROR_MESSAGES.FORBIDDEN;

    case 409:
      return FALLBACK_DECISION_ERROR_MESSAGES.CONFLICT;

    default:
      return FALLBACK_DECISION_ERROR_MESSAGES.UNEXPECTED;
  }
}

private openAlert(
  status: 'danger' | 'warning' | 'success',
  message: DecisionMessage,
): void {
  this.modalService.open({
    status,
    title: message.title,
    html: message.html,
    type: 'alert',
  });
}
