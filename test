const createAttributeSuccessMessage = (
  action: AttributeChangeAction,
  data: AttributeSuccessData,
): NotificationMessage => {
  if (!data.created) {
    return {
      title: 'Wniosek już istnieje',
      html: `
        <p>Ta czynność została już wcześniej zgłoszona.
          Nie utworzono kolejnego wniosku.</p>
        ${createAttributeDetails(data)}
        <p>Sprawdź status istniejącego wniosku,
          aby ustalić dalszy przebieg jego rozpatrywania.</p>
      `,
    };
  }

  const operationMessage =
    action === 'SET'
      ? 'Wniosek o zmianę wartości atrybutu został utworzony.'
      : 'Wniosek o usunięcie wartości atrybutu został utworzony.';

  return {
    title: 'Wniosek został utworzony',
    html: `
      <p>${operationMessage}</p>
      ${createAttributeDetails(data)}
      <p>Wartość atrybutu nie została jeszcze zmieniona.</p>
      <p>Status rozpatrywania i wynik realizacji zmiany
        możesz sprawdzić w szczegółach wniosku.</p>
    `,
  };
};
