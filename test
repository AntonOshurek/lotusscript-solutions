import { Injectable } from '@angular/core';

import type { IncidentDecisionKind } from '@entities/governance';

import { NotificationDialogBase } from '@shared/notifications';

import {
  INCIDENT_DIALOG_CONFIG,
  INCIDENT_SUCCESS_MESSAGES,
} from './incident-decision-notifications.model';

@Injectable()
export class IncidentDecisionDialogService
  extends NotificationDialogBase<IncidentDecisionKind> {

  constructor() {
    super(INCIDENT_DIALOG_CONFIG);
  }

  openSuccess(decisionKind: IncidentDecisionKind): void {
    this.openAlert(
      'success',
      INCIDENT_SUCCESS_MESSAGES[decisionKind],
    );
  }
}
