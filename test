import { map, of, switchMap, type Observable } from 'rxjs';

loadRowEditDiff(
  props: LoadRowEditDiffProps,
): Observable<LoadRowEditDiffResponse> {
  const { intentRefId, rowEditPhase, targetCode } = props;

  return this.rowEditQueriesApi.getRowEditById(intentRefId).pipe(
    switchMap(({ data: view }) => {
      const { rowEdit } = view;

      const needsLive =
        rowEdit.operation === 'DELETE' ||
        (rowEditPhase === 'OPEN' && rowEdit.operation === 'EDIT');

      const live$ = needsLive
        ? this.rowEditQueriesApi.getRowEditLiveById(intentRefId).pipe(
            map(({ data }) => data),
          )
        : of(undefined);

      return live$.pipe(
        map((live): LoadRowEditDiffResponse => {
          const mapper =
            rowEditPhase === 'OPEN'
              ? mapRowEditDiff
              : mapRowEditClosedDiff;

          return {
            rowData: mapper(targetCode, view, live),
            casePhase: view.caseRef.phase,
            ...(rowEdit.operation === 'EDIT' && {
              pkValue: rowEdit.rows[0].pkValue,
              expectedVersion:
                rowEdit.rows[0].expectedVersion ?? undefined,
            }),
            ...(rowEdit.operation === 'DELETE' && {
              pkValue: rowEdit.deletePkValue,
            }),
          };
        }),
      );
    }),
  );
}






const mapFields = (
  fields: RowEditFields,
  targetCode: string | null | undefined,
  groupName: string,
): RowEditDiffRow[] =>
  Object.entries(fields)
    .filter(([, value]) => value !== undefined)
    .map(([field, value]) => {
      const fieldName = targetCode
        ? fieldNameMap(field, targetCode)
        : field;

      return {
        field: fieldName,
        currentValue: value!,
        path: [groupName, fieldName],
      };
    });






const mapFields = (
  fields: RowEditFields,
  targetCode: string | null | undefined,
  groupName: string,
): RowEditDiffRow[] => {
  const rows: RowEditDiffRow[] = [];

  for (const [field, currentValue] of Object.entries(fields)) {
    if (currentValue === undefined) continue;

    const fieldName = targetCode
      ? fieldNameMap(field, targetCode)
      : field;

    rows.push({
      field: fieldName,
      currentValue,
      path: [groupName, fieldName],
    });
  }

  return rows;
};






const mapRowEditDiff = (
  targetCode: string | null | undefined,
  viewItem: RowEditViewItem,
  liveItem?: RowEditLiveItem,
): RowEditDiffRow[] => {
  const { rowEdit } = viewItem;
  const liveValues = liveItem?.rows[0]?.liveValues ?? {};

  if (rowEdit.operation !== 'EDIT') {
    const fields =
      rowEdit.operation === 'CREATE'
        ? rowEdit.createValues
        : liveValues;

    return mapFields(
      fields,
      targetCode,
      ROW_EDIT_TREE_NAMES.FIELDS_TO_CHANGE,
    );
  }

  const changedRows: RowEditDiffRow[] = [];
  const otherRows: RowEditDiffRow[] = [];

  for (const [field, proposedValue] of Object.entries(
    rowEdit.rows[0].newValues,
  )) {
    if (proposedValue === undefined) continue;

    const currentValue = liveValues[field] ?? null;
    const fieldName = targetCode
      ? fieldNameMap(field, targetCode)
      : field;

    const isChanged = proposedValue !== currentValue;

    const row: RowEditDiffRow = {
      field: fieldName,
      currentValue,
      proposedValue,
      path: [
        isChanged
          ? ROW_EDIT_TREE_NAMES.FIELDS_TO_CHANGE
          : ROW_EDIT_TREE_NAMES.OTHER_FIELDS,
        fieldName,
      ],
    };

    if (isChanged) {
      changedRows.push(row);
    } else {
      otherRows.push(row);
    }
  }

  return [...changedRows, ...otherRows];
};




const mapRowEditClosedDiff = (
  targetCode: string | null | undefined,
  viewItem: RowEditViewItem,
  liveItem?: RowEditLiveItem,
): RowEditDiffRow[] => {
  const { rowEdit } = viewItem;
  let fields: RowEditFields;

  switch (rowEdit.operation) {
    case 'EDIT':
      fields = rowEdit.rows[0].newValues;
      break;

    case 'CREATE':
      fields = rowEdit.createValues;
      break;

    case 'DELETE':
      fields = liveItem?.rows[0]?.liveValues ?? {};
      break;
  }

  return mapFields(
    fields,
    targetCode,
    ROW_EDIT_TREE_NAMES.ACCEPTED_FIELDS,
  );
};

export { mapRowEditDiff, mapRowEditClosedDiff };
