import { inject, Injectable } from '@angular/core';

import type {
  GovernanceCaseDecisionResponse,
} from '@entities/governance';

import {
  mapErrorToUiError,
  type UiError,
} from '@shared/error';

import {
  MtModalService,
} from '@citi-icg-172888/ng-icgds/modal';

import {
  CANCEL_CASE_CONFIRMATION,
  CANCEL_CASE_ERROR_MESSAGES,
  CANCEL_CASE_FALLBACK_MESSAGES,
  CANCEL_CASE_INVALID_PAYLOAD,
  CANCEL_CASE_RESULT_MESSAGES,
  type CancelCaseMessage,
} from './cancel-case-notifications.model';

@Injectable()
export class CancelCaseDialogService {
  private readonly modalService = inject(MtModalService);

  openInvalidPayload(): void {
    this.openAlert('danger', CANCEL_CASE_INVALID_PAYLOAD);
  }

  openConfirmation(onAccept: () => void): void {
    this.modalService.open({
      status: 'warning',
      title: CANCEL_CASE_CONFIRMATION.title,
      html: CANCEL_CASE_CONFIRMATION.html,
      type: 'confirm',
      afterUserAction: event => {
        if (event.action === 'accept') {
          onAccept();
        }
      },
    });
  }

  openResponseError(err: unknown): void {
    const uiError = mapErrorToUiError(err);
    const detail = uiError.backendError?.detail;

    const message =
      typeof detail === 'string'
        ? CANCEL_CASE_ERROR_MESSAGES[detail]
        : undefined;

    this.openAlert(
      'danger',
      message ?? this.getFallbackErrorMessage(uiError.errorCode),
    );
  }

  openSuccess(data: GovernanceCaseDecisionResponse): void {
    if (data.phase === 'INCIDENT') {
      this.openAlert(
        'warning',
        CANCEL_CASE_RESULT_MESSAGES.INCIDENT,
      );
      return;
    }

    if (
      data.phase === 'CLOSED' &&
      data.outcome === 'CONFLICT_REFUSED'
    ) {
      this.openAlert(
        'warning',
        CANCEL_CASE_RESULT_MESSAGES.CONFLICT_REFUSED,
      );
      return;
    }

    if (
      data.phase === 'CLOSED' &&
      data.outcome === 'SUCCEEDED'
    ) {
      this.openAlert(
        'success',
        CANCEL_CASE_RESULT_MESSAGES.SUCCEEDED,
      );
      return;
    }

    this.openAlert(
      'warning',
      CANCEL_CASE_RESULT_MESSAGES.UNCONFIRMED,
    );
  }

  private getFallbackErrorMessage(
    errorCode: UiError['errorCode'],
  ): CancelCaseMessage {
    switch (errorCode) {
      case 400:
        return CANCEL_CASE_FALLBACK_MESSAGES.INVALID_REQUEST;

      case 403:
        return CANCEL_CASE_FALLBACK_MESSAGES.FORBIDDEN;

      case 409:
        return CANCEL_CASE_FALLBACK_MESSAGES.CONFLICT;

      default:
        return CANCEL_CASE_FALLBACK_MESSAGES.UNEXPECTED;
    }
  }

  private openAlert(
    status: 'danger' | 'warning' | 'success',
    message: CancelCaseMessage,
  ): void {
    this.modalService.open({
      status,
      title: message.title,
      html: message.html,
      type: 'alert',
    });
  }
}













private sendCancelCase(payload: CancelCaseFeaturePayload): void {
  this.loaderService.show();

  this.governanceCommandsApi
    .caseCancel(payload, payload.caseId)
    .pipe(
      finalize(() => this.loaderService.hide()),
    )
    .subscribe({
      next: data => {
        this.caseRefreshEvent.refreshCase(+payload.caseId);
        this.dialogService.openSuccess(data);
      },
      error: (error: unknown) => {
        this.caseRefreshEvent.refreshCase(+payload.caseId);
        this.dialogService.openResponseError(error);
      },
    });
}
