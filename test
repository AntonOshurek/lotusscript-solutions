import { inject, Injectable } from '@angular/core';

import {
  defer,
  finalize,
  retry as retryRequest,
  throwError,
  timer,
  type Observable,
} from 'rxjs';

import {
  GovernanceCommandsApi,
  GovernanceRefreshEvent,
  type GovernanceIncidentDecisionResponse,
} from '@entities/governance';

import { mapErrorToUiError } from '@shared/error';

import type {
  IncidentDecideProps,
} from './model/incident-decision.model';

import {
  IncidentDecisionDialogService,
} from './model/incident-decision-dialog.service';

import {
  MtLoaderService,
} from '@citi-icg-172888/ng-icgds';

const RESOURCE_BUSY_RETRY_COUNT = 2;
const RESOURCE_BUSY_RETRY_DELAY_MS = 500;

@Injectable()
export class IncidentDecisionFeature {
  private readonly loaderService = inject(MtLoaderService);

  private readonly governanceCommandsApi =
    inject(GovernanceCommandsApi);

  private readonly governanceRefreshEvent =
    inject(GovernanceRefreshEvent);

  private readonly incidentDecisionDialogService =
    inject(IncidentDecisionDialogService);

  public decide(props: IncidentDecideProps): void {
    const { decisionPayload, decisionKind } = props;

    if (!decisionPayload) {
      this.incidentDecisionDialogService.openInvalidPayload();
      return;
    }

    const reason = decisionPayload.reason?.trim();

    if (!reason) {
      this.incidentDecisionDialogService.openReasonRequired();
      return;
    }

    const preparedProps: IncidentDecideProps = {
      ...props,
      decisionPayload: {
        ...decisionPayload,
        reason,
      },
    };

    switch (decisionKind) {
      case 'ABANDON':
        this.incidentDecisionDialogService.abandonConfirmation(
          () => this.abandon(preparedProps),
        );
        return;

      case 'RETRY':
        this.incidentDecisionDialogService.retryConfirmation(
          () => this.retry(preparedProps),
        );
        return;

      default: {
        const unhandledKind: never = decisionKind;

        throw new Error(
          `Unhandled incident decision kind: ${unhandledKind}`,
        );
      }
    }
  }

  private abandon(props: IncidentDecideProps): void {
    this.executeDecision(
      () =>
        this.governanceCommandsApi.incidentAbandon(
          props.decisionPayload,
          String(props.incId),
        ),
      props,
    );
  }

  private retry(props: IncidentDecideProps): void {
    this.executeDecision(
      () =>
        this.governanceCommandsApi.incidentRetry(
          props.decisionPayload,
          String(props.incId),
        ),
      props,
    );
  }

  private executeDecision(
    createRequest: () => Observable<{
      data: GovernanceIncidentDecisionResponse;
    }>,
    { incId, decisionKind }: IncidentDecideProps,
  ): void {
    this.loaderService.show();

    defer(createRequest)
      .pipe(
        retryRequest({
          count: RESOURCE_BUSY_RETRY_COUNT,

          delay: (error: unknown, retryCount: number) => {
            const uiError = mapErrorToUiError(error);

            const isResourceBusy =
              uiError.errorCode === 409 &&
              uiError.backendError?.detail ===
                'GOV_RESOURCE_BUSY';

            if (!isResourceBusy) {
              return throwError(() => error);
            }

            return timer(
              RESOURCE_BUSY_RETRY_DELAY_MS * retryCount,
            );
          },
        }),

        finalize(() => {
          this.loaderService.hide();
        }),
      )
      .subscribe({
        next: () => {
          this.governanceRefreshEvent.refreshIncident(incId);

          this.incidentDecisionDialogService.success(
            decisionKind,
          );
        },

        error: (error: unknown) => {
          this.governanceRefreshEvent.refreshIncident(incId);

          this.incidentDecisionDialogService.openResponseError(
            error,
          );
        },
      });
  }
}







import { Injectable } from '@angular/core';

import type {
  IncidentDecisionKind,
} from '@entities/governance';

import {
  NotificationDialogBase,
} from '@shared/notifications';

import {
  INCIDENT_DIALOG_CONFIG,
  INCIDENT_REASON_REQUIRED_MESSAGE,
  INCIDENT_SUCCESS_MESSAGES,
} from './incident-decision-notification.model';

@Injectable()
export class IncidentDecisionDialogService
  extends NotificationDialogBase<IncidentDecisionKind> {
  constructor() {
    super(INCIDENT_DIALOG_CONFIG);
  }

  openReasonRequired(): void {
    this.openAlert(
      'danger',
      INCIDENT_REASON_REQUIRED_MESSAGE,
    );
  }

  abandonConfirmation(onAccept: () => void): void {
    this.openConfirmation('ABANDON', onAccept);
  }

  retryConfirmation(onAccept: () => void): void {
    this.openConfirmation('RETRY', onAccept);
  }

  success(decisionKind: IncidentDecisionKind): void {
    this.openAlert(
      'success',
      INCIDENT_SUCCESS_MESSAGES[decisionKind],
    );
  }
}
