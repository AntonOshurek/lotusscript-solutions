const UPDATE_ROW_VALIDATION_FALLBACK_MESSAGE =
  'Wartość nie spełnia wymagań walidacji.';

protected override openUiError(uiError: UiError): void {
  const backendError = uiError.backendError;

  if (
    uiError.errorCode !== 400 ||
    backendError?.detail !== 'GOV_INTENT_INVALID' ||
    backendError.violations.length === 0
  ) {
    super.openUiError(uiError);
    return;
  }

  const messages: Readonly<Partial<Record<string, string>>> =
    UPDATE_ROW_VALIDATION_MESSAGES;

  const items = backendError.violations.map(
    ({ field, message: code }) => {
      const message = Object.prototype.hasOwnProperty.call(
        messages,
        code,
      )
        ? messages[code] ?? UPDATE_ROW_VALIDATION_FALLBACK_MESSAGE
        : UPDATE_ROW_VALIDATION_FALLBACK_MESSAGE;

      const column =
        /^(?:rows\[\d+\]\.)?newValues\.(.+)$/.exec(field)?.[1];

      const location = column
        ? `Kolumna ${escapeHtml(column)}: `
        : '';

      return `<li>${location}${escapeHtml(message)}</li>`;
    },
  );

  const validationHtml = [...new Set(items)].join('');

  this.openErrorAlert(uiError, {
    title: 'Dane wymagają poprawy',
    html: `
      <p>
        Wniosek nie został utworzony.
        Popraw dane edytowanego rekordu.
      </p>
      <ul>${validationHtml}</ul>
      <p>
        Jeśli komunikat nie wskazuje kolumny,
        sprawdź wprowadzone wartości w edytowanym rekordzie.
      </p>
    `,
  });
}

