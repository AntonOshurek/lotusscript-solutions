function escapeHtml(value: string): string {
  return value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function formatValue(value: RowEditValue): string {
  return value === null ? 'Brak wartości' : String(value);
}

function createUpdateRowConfirmation(
  data: UpdateRowConfirmationData,
): NotificationMessage {
  const fieldsHtml = data.fields
    .map(field => {
      const oldValue = escapeHtml(formatValue(field.oldValue));

      const newValue =
        field.newValue === null
          ? 'Wartość zostanie usunięta'
          : escapeHtml(formatValue(field.newValue));

      return `
        <li>
          <b>${escapeHtml(field.label)}</b><br>
          Obecna wartość: <b>${oldValue}</b><br>
          Proponowana wartość: <b>${newValue}</b>
        </li>
      `;
    })
    .join('');

  return {
    title: UPDATE_ROW_CONFIRMATION.title,
    html: `
      ${UPDATE_ROW_CONFIRMATION.html}
      <p>
        <b>${escapeHtml(data.recordIdLabel)}</b>:
        ${escapeHtml(data.recordId)}
      </p>
      <ul>${fieldsHtml}</ul>
    `,
  };
}

