import { inject, Injectable } from '@angular/core';

// ENTITIES
import type {
  GovernanceDecisionKind,
  GovernanceResponseDto,
} from '@entities/governance';
import {
  GOVERNANCE_OUTCOME_LABEL,
  GOVERNANCE_PHASE_LABEL,
} from '@entities/governance';

// MODEL
import {
  CONFIRM_MAKE_DECISION_NOTIFICATION,
  ERROR_MAKE_DECISION_NOTIFICATION,
  SUCCESS_MAKE_DECISION_NOTIFICATION,
} from './make-decision-notifications.model';

// ERROR
import type { UiError } from '@shared/error';

// ICG
import { MtModalService } from '@citi-icg-172888/ng-icgds/modal';

@Injectable()
export class MakeDecisionDialogService {
  private readonly modalService = inject(MtModalService);

  openInvalidPayload(
    decisionKind: GovernanceDecisionKind,
  ): void {
    const notification =
      ERROR_MAKE_DECISION_NOTIFICATION.DECISION_PAYLOAD_INVALID_VALUES;

    this.modalService.open({
      status: 'danger',
      title: notification.title,
      html: notification.html(decisionKind),
      type: 'alert',
    });
  }

  openConfirmation(
    decisionKind: GovernanceDecisionKind,
    onAccept: () => void,
  ): void {
    const notification =
      CONFIRM_MAKE_DECISION_NOTIFICATION[decisionKind];

    this.modalService.open({
      status: 'warning',
      title: notification.title,
      html: notification.html,
      type: 'confirm',
      afterUserAction: (event) => {
        if (event.action === 'accept') {
          onAccept();
        }
      },
    });
  }

  openSuccess(
    decisionKind: GovernanceDecisionKind,
    data: GovernanceResponseDto,
  ): void {
    const notification =
      SUCCESS_MAKE_DECISION_NOTIFICATION[decisionKind];

    this.modalService.open({
      status: 'success',
      title: notification.title,
      html: this.getDecisionResultHtml(data),
      type: 'alert',
    });
  }

  openUnsuccessfulResult(
    data: GovernanceResponseDto,
  ): void {
    this.modalService.open({
      status: 'warning',
      title: 'Operacja nie została zakończona pomyślnie.',
      html: this.getDecisionResultHtml(data),
      type: 'alert',
    });
  }

  openConflictError(
    uiError: UiError,
    decisionKind: GovernanceDecisionKind,
  ): void {
    const notification =
      ERROR_MAKE_DECISION_NOTIFICATION.DECISION_SUBMIT_FAILED_BY_CONFLICT;

    this.modalService.open({
      status: 'danger',
      title: notification.title,
      html: notification.html({
        uiError,
        decisionKind,
      }),
      type: 'alert',
    });
  }

  openSubmitError(
    uiError: UiError,
    decisionKind: GovernanceDecisionKind,
  ): void {
    const notification =
      ERROR_MAKE_DECISION_NOTIFICATION.DECISION_SUBMIT_FAILED;

    this.modalService.open({
      status: 'danger',
      title: notification.title,
      html: notification.html({
        uiError,
        decisionKind,
      }),
      type: 'alert',
    });
  }

  private getDecisionResultHtml(
    data: GovernanceResponseDto,
  ): string {
    return `
      <div>
        <p>Wynik: ${
          GOVERNANCE_OUTCOME_LABEL[data.outcome] ?? data.outcome
        }</p>
        <p>Etap: ${
          GOVERNANCE_PHASE_LABEL[data.phase] ?? data.phase
        }</p>
      </div>
    `;
  }
}




import { inject, Injectable } from '@angular/core';

// ENTITIES
import {
  GovernanceCommandsApi,
} from '@entities/governance';

import type {
  GovernanceDecisionKind,
  GovernanceDecisionRequestDto,
  GovernanceResponseDto,
} from '@entities/governance';

// MODEL
import type {
  MakeDecisionFeaturePayload,
  PrecomputedMakeDecisionPayload,
} from './model/make-decision.model';

import { MakeDecisionDialogService } from './model/make-decision-dialog.service';

// ERROR
import { mapErrorToUiError } from '@shared/error';

@Injectable({
  providedIn: 'root',
})
export class MakeDecisionFeature {
  private readonly governanceCommandsApi =
    inject(GovernanceCommandsApi);

  private readonly dialogService =
    inject(MakeDecisionDialogService);

  public decide(
    details: PrecomputedMakeDecisionPayload,
    decisionKind: GovernanceDecisionKind,
  ): void {
    if (!details) {
      this.dialogService.openInvalidPayload(decisionKind);
      return;
    }

    this.dialogService.openConfirmation(
      decisionKind,
      () => {
        this.runDecision(
          {
            ...details,
            kind: decisionKind,
          },
          decisionKind,
        );
      },
    );
  }

  private runDecision(
    payload: MakeDecisionFeaturePayload,
    decisionKind: GovernanceDecisionKind,
  ): void {
    this.sendDecision(payload).subscribe({
      next: ({ data }: { data: GovernanceResponseDto }) => {
        if (data.outcome === 'SUCCEEDED') {
          this.dialogService.openSuccess(
            decisionKind,
            data,
          );

          return;
        }

        this.dialogService.openUnsuccessfulResult(data);
      },

      error: (error: unknown) => {
        const uiError = mapErrorToUiError(error);

        if (uiError.errorCode === 409) {
          this.dialogService.openConflictError(
            uiError,
            decisionKind,
          );

          return;
        }

        this.dialogService.openSubmitError(
          uiError,
          decisionKind,
        );
      },
    });
  }

  private sendDecision(
    payload: MakeDecisionFeaturePayload,
  ) {
    const requestBody: GovernanceDecisionRequestDto = {
      kind: payload.kind,
      expectedCaseVersion: payload.expectedCaseVersion,
      reason: payload.reason,
    };

    return this.governanceCommandsApi.caseDecision(
      requestBody,
      payload.caseId,
    );
  }
}
